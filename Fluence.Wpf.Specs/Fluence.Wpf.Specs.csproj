<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Fluence.Wpf.Specs</RootNamespace>
    <AssemblyName>Fluence.Wpf.Specs</AssemblyName>
    <Description>Serializable dialog-spec object model for Fluence.Wpf in-process and out-of-process dialog composition</Description>
    <Product>Fluence.Wpf.Specs</Product>
    <Title>Fluence.Wpf.Specs</Title>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!--
      VSTHRD002: FluenceRemoteHostController is deliberately a synchronous facade for PowerShell
      callers (no synchronization context involved), so its bounded sync-over-async waits are the
      design, not an oversight. S2952: the controller disposes its pipe/process fields from a
      shared cleanup path reused by both Dispose and the relaunch-after-host-exit path; Sonar only
      credits disposals lexically inside Dispose.
    -->
    <NoWarn>$(NoWarn);VSTHRD002;S2952</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluence.Wpf.Specs.Generator\Fluence.Wpf.Specs.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="SpecSurface.xml" />
  </ItemGroup>

</Project>
