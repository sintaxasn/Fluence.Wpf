<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>Fluence.Wpf.Demo.Mvvm</RootNamespace>
    <AssemblyName>Fluence.Wpf.Demo.Mvvm</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationIcon>Resources\fluence-wpf-appicon-256.ico</ApplicationIcon>
    <!-- slopwatch-ignore: SW005 MVVM demo intentionally suppresses XML docs and WPF threading analyzer noise outside the library API. -->
    <NoWarn>$(NoWarn);CS1591;VSTHRD001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluence.Wpf\Fluence.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\fluence-wpf-appicon-256.ico" />
  </ItemGroup>

</Project>
