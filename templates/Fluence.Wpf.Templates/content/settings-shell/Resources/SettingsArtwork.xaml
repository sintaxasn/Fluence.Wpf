<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Original sample artwork. The theme-aware outline keeps each colored mark
         recognizable against Light, Dark, and High Contrast surfaces. -->
    <DrawingImage x:Key="SettingsAppArtwork">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#2176C1" Geometry="M 3,3 L 11,3 11,11 3,11 Z" />
                <GeometryDrawing Brush="#F2A900" Geometry="M 13,3 L 21,3 21,11 13,11 Z" />
                <GeometryDrawing Brush="#20A58A" Geometry="M 3,13 L 11,13 11,21 3,21 Z" />
                <GeometryDrawing Brush="#D85D8F" Geometry="M 13,13 L 21,13 21,21 13,21 Z" />
                <GeometryDrawing Geometry="M 3,3 L 11,3 11,11 3,11 Z M 13,3 L 21,3 21,11 13,11 Z M 3,13 L 11,13 11,21 3,21 Z M 13,13 L 21,13 21,21 13,21 Z">
                    <GeometryDrawing.Pen><Pen Brush="{DynamicResource TextFillColorPrimaryBrush}" Thickness="0.8" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="SettingsGeneralArtwork">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#2176C1" Geometry="M 3,5 L 21,5 21,19 3,19 Z" />
                <GeometryDrawing Brush="#F2A900" Geometry="M 6,8 L 12,8 12,16 6,16 Z" />
                <GeometryDrawing Brush="#35B9A5" Geometry="M 14,8 L 18,8 18,11 14,11 Z M 14,13 L 18,13 18,16 14,16 Z" />
                <GeometryDrawing Geometry="M 3,5 L 21,5 21,19 3,19 Z">
                    <GeometryDrawing.Pen><Pen Brush="{DynamicResource TextFillColorPrimaryBrush}" Thickness="1" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="SettingsAppearanceArtwork">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F2B830">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="10,11" RadiusX="7" RadiusY="7" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#2167B4" Geometry="M 11,3 C 8,11 13,17 20,16 C 17,21 10,22 6,17 C 11,17 13,12 11,3 Z" />
                <GeometryDrawing Brush="#D85D8F">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="18,5" RadiusX="2" RadiusY="2" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 10,4 C 5,4 3,7 3,11 C 3,16 7,19 12,19 M 14,19 C 19,18 21,14 21,10">
                    <GeometryDrawing.Pen><Pen Brush="{DynamicResource TextFillColorPrimaryBrush}" Thickness="1" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="SettingsNotificationsArtwork">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#E36867" Geometry="M 5,16 C 7,14 7,12 7,9 C 7,5 9,4 12,4 C 15,4 17,6 17,9 C 17,12 18,14 20,16 L 20,18 4,18 4,16 Z" />
                <GeometryDrawing Brush="#F2B830">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="12,20" RadiusX="2.5" RadiusY="2" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#26B4AB">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="18.5,6" RadiusX="3" RadiusY="3" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 5,16 C 7,14 7,12 7,9 C 7,5 9,4 12,4 C 15,4 17,6 17,9 C 17,12 18,14 20,16 L 20,18 4,18 4,16 Z">
                    <GeometryDrawing.Pen><Pen Brush="{DynamicResource TextFillColorPrimaryBrush}" Thickness="1" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="SettingsAboutArtwork">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#7A67B8">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F2B830">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="12,7" RadiusX="1.5" RadiusY="1.5" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#45CEBD" Geometry="M 10.8,10 L 13.2,10 13.2,17 10.8,17 Z" />
                <GeometryDrawing>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9" /></GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen><Pen Brush="{DynamicResource TextFillColorPrimaryBrush}" Thickness="1" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
