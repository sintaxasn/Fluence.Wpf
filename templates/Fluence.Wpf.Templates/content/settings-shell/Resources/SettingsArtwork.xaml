                <GeometryDrawing Brush="#E36867" Geometry="M 3,10.5 L 9,10.5 9,13.5 3,13.5 Z M 11,10.5 L 18,10.5 18,13.5 11,13.5 Z" />
                <GeometryDrawing Brush="#31B8A5" Geometry="M 3,16 L 9,16 9,19 3,19 Z M 11,16 L 21,16 21,19 11,19 Z" />
                <GeometryDrawing Geometry="M 3,5 L 9,5 9,8 3,8 Z M 11,5 L 21,5 21,8 11,8 Z M 3,10.5 L 9,10.5 9,13.5 3,13.5 Z M 11,10.5 L 18,10.5 18,13.5 11,13.5 Z M 3,16 L 9,16 9,19 3,19 Z M 11,16 L 21,16 21,19 11,19 Z">
                    <GeometryDrawing.Pen><Pen Brush="{DynamicResource TextFillColorPrimaryBrush}" Thickness="0.5" /></GeometryDrawing.Pen>
