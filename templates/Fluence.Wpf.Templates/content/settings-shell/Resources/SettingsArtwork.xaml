            <DrawingGroup>
                <GeometryDrawing Brush="#7A67B8" Geometry="M 4,5 L 20,5 20,21 4,21 Z" />
                <GeometryDrawing Brush="#F2B830" Geometry="M 9,3 L 15,3 15,7 9,7 Z" />
                <GeometryDrawing Brush="#46D4BF" Geometry="M 7,11 L 10,14 13,10 14.5,11 10,17 6,12 Z" />
                <GeometryDrawing Brush="#46D4BF" Geometry="M 15,15 L 18,15 18,17 15,17 Z" />
                <GeometryDrawing Geometry="M 4,5 L 20,5 20,21 4,21 Z">
                    <GeometryDrawing.Pen><Pen Brush="{DynamicResource TextFillColorPrimaryBrush}" Thickness="1" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
