    <DrawingImage x:Key="SettingsQuietArtwork">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#7868BC" Geometry="M 11,3 C 6,8 9,16 17,16 C 14,21 7,21 4,16 C 1,11 4,5 11,3 Z" />
                <GeometryDrawing Brush="#F2B830" Geometry="M 17,3 L 18,6 21,7 18,8 17,11 16,8 13,7 16,6 Z" />
                <GeometryDrawing Geometry="M 11,3 C 6,8 9,16 17,16 C 14,21 7,21 4,16 C 1,11 4,5 11,3 Z">
                    <GeometryDrawing.Pen><Pen Brush="{DynamicResource TextFillColorPrimaryBrush}" Thickness="1" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="SettingsResetArtwork">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#28AFA6">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="12,12" RadiusX="8" RadiusY="8" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F2B830" Geometry="M 16,3 L 21,4 21,9 18,7 15,9 Z" />
                <GeometryDrawing Brush="#496FC2" Geometry="M 10,7 L 13,7 13,12 17,12 17,15 10,15 Z" />
                <GeometryDrawing>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="12,12" RadiusX="8" RadiusY="8" /></GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen><Pen Brush="{DynamicResource TextFillColorPrimaryBrush}" Thickness="1" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
