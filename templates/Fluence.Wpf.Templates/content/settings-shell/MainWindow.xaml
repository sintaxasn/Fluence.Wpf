<fluence:FluenceWindow
    x:Class="FluenceStarterApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com"
    xmlns:settingsControls="clr-namespace:FluenceStarterApp.Controls"
    Title="FluenceStarterApp settings"
    Width="1080"
    Height="760"
    MinWidth="760"
    MinHeight="500"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    SystemBackdropType="Mica"
    UseLayoutRounding="True"
    PreviewKeyDown="MainWindow_PreviewKeyDown">
    <fluence:FluenceWindow.TitleBar>
        <fluence:TitleBar
            x:Name="AppTitleBar"
            Margin="12,0,0,0"
            Title="FluenceStarterApp settings"
            Subtitle="General"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="False"
            BackRequested="AppTitleBar_BackRequested" />
    </fluence:FluenceWindow.TitleBar>
    <fluence:NavigationView
        x:Name="CategoryNavigation"
        Margin="10,0,0,0"
        PaneDisplayMode="Left"
        IsPaneOpen="True"
        IsBackButtonVisible="False"
        ItemInvoked="CategoryNavigation_ItemInvoked">
        <fluence:NavigationView.Resources>
            <Style TargetType="{x:Type fluence:NavigationViewItem}" BasedOn="{StaticResource {x:Type fluence:NavigationViewItem}}">
                <Setter Property="Margin" Value="0,0,30,0" />
            </Style>
        </fluence:NavigationView.Resources>
        <fluence:NavigationViewItem x:Name="GeneralNavigationItem" Content="General" Tag="general" AutomationProperties.Name="General settings">
            <fluence:NavigationViewItem.Icon>
                <settingsControls:SettingsCategoryImage Width="20" Height="20" Category="General" />
            </fluence:NavigationViewItem.Icon>
        </fluence:NavigationViewItem>
        <fluence:NavigationViewItem x:Name="AppearanceNavigationItem" Content="Appearance" Tag="appearance" AutomationProperties.Name="Appearance settings">
            <fluence:NavigationViewItem.Icon>
                <settingsControls:SettingsCategoryImage Width="20" Height="20" Category="Appearance" />
            </fluence:NavigationViewItem.Icon>
        </fluence:NavigationViewItem>
        <fluence:NavigationViewItem x:Name="NotificationsNavigationItem" Content="Notifications" Tag="notifications" AutomationProperties.Name="Notification settings">
            <fluence:NavigationViewItem.Icon>
                <settingsControls:SettingsCategoryImage Width="20" Height="20" Category="Notifications" />
            </fluence:NavigationViewItem.Icon>
        </fluence:NavigationViewItem>
        <fluence:NavigationViewItem x:Name="AboutNavigationItem" Content="About" Tag="about" AutomationProperties.Name="About this app">
            <fluence:NavigationViewItem.Icon>
                <settingsControls:SettingsCategoryImage Width="20" Height="20" Category="About" />
            </fluence:NavigationViewItem.Icon>
        </fluence:NavigationViewItem>
        <fluence:NavigationView.Content>
            <!--  Reclaim 28 DIP of the fixed 320 DIP pane's trailing gutter, while keeping 6 DIP clear of the selected pill.  -->
            <ContentControl x:Name="PageHost" Focusable="False" Margin="-28,0,0,0" />
        </fluence:NavigationView.Content>
    </fluence:NavigationView>
</fluence:FluenceWindow>
