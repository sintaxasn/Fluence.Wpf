<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryFormsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" HorizontalAlignment="Stretch">
            <TextBlock
                Margin="0,0,0,4"
                ui:TextBlockExtensions.Typography="Title"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Forms" />
            <TextBlock
                Margin="0,0,0,24"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Forms group related inputs, labels, validation feedback, and actions into a single task flow." />

            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="Sign in" />
            <TextBlock
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Use a compact form for account access, with clear labels and a primary action." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                    <TextBlock
                        Margin="0,0,0,4"
                        ui:TextBlockExtensions.Typography="Caption"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Email" />
                    <ui:TextBox
                        x:Name="SignInEmailBox"
                        Margin="0,0,0,12"
                        PlaceholderText="name@example.com"
                        TextChanged="SignInField_Changed" />
                    <TextBlock
                        Margin="0,0,0,4"
                        ui:TextBlockExtensions.Typography="Caption"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Password" />
                    <ui:PasswordBox
                        x:Name="SignInPasswordBox"
                        Margin="0,0,0,12"
                        PlaceholderText="Password"
                        RevealButtonEnabled="True" />
                    <ui:CheckBox
                        x:Name="RememberMeCheckBox"
                        Margin="0,0,0,16"
                        Content="Remember me" />
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <ui:Button
                            x:Name="SignInButton"
                            Margin="0,0,8,0"
                            Appearance="Accent"
                            Click="SignInButton_Click"
                            Content="Sign in"
                            IsEnabled="False" />
                        <ui:Button Content="Create account" />
                    </StackPanel>
                    <ui:InfoBar
                        x:Name="SignInStatusBar"
                        Margin="0,0,0,12"
                        IsClosable="True"
                        IsOpen="False"
                        Message="Signed in for this demo session."
                        Severity="{x:Static uicore:InfoBarSeverity.Success}"
                        Title="Ready" />
                    <ui:HyperlinkButton
                        x:Name="SignInFormSourceLink"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Checkout" />
            <TextBlock
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Combine contact, shipping, and quantity fields when a form needs several related decisions." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock
                        Margin="0,0,0,4"
                        ui:TextBlockExtensions.Typography="Caption"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Contact email" />
                    <ui:TextBox
                        Margin="0,0,0,12"
                        PlaceholderText="name@example.com" />
                    <TextBlock
                        Margin="0,0,0,4"
                        ui:TextBlockExtensions.Typography="Caption"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Shipping speed" />
                    <ui:ComboBox
                        Margin="0,0,0,12"
                        SelectedIndex="1">
                        <ComboBoxItem Content="Standard" />
                        <ComboBoxItem Content="Priority" />
                        <ComboBoxItem Content="Overnight" />
                    </ui:ComboBox>
                    <WrapPanel Margin="0,0,0,12">
                        <ui:NumberBox
                            Width="180"
                            Margin="0,0,16,12"
                            Header="Quantity"
                            Maximum="10"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact"
                            Value="2" />
                        <ui:TextBox
                            Width="280"
                            Margin="0,0,0,12"
                            PlaceholderText="Optional" />
                    </WrapPanel>
                    <ui:CheckBox
                        Margin="0,0,0,16"
                        Content="This is a gift"
                        Description="Hide prices on the packing slip." />
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Appearance="Accent"
                            Content="Place order" />
                        <ui:Button Content="Save for later" />
                    </StackPanel>
                    <ui:HyperlinkButton
                        x:Name="CheckoutFormSourceLink"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Settings" />
            <TextBlock
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Use form controls to edit a small set of preferences and show confirmation after saving." />
            <ui:Card Padding="16" Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock
                        Margin="0,0,0,4"
                        ui:TextBlockExtensions.Typography="Caption"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Display name" />
                    <ui:TextBox
                        Margin="0,0,0,12"
                        Text="Avery Stone" />
                    <TextBlock
                        Margin="0,0,0,4"
                        ui:TextBlockExtensions.Typography="Caption"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Theme" />
                    <ui:ComboBox
                        Margin="0,0,0,12"
                        SelectedIndex="0">
                        <ComboBoxItem Content="Use system setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ui:ComboBox>
                    <ui:ToggleSwitch
                        x:Name="EmailUpdatesToggle"
                        Margin="0,0,0,16"
                        Content="Email updates"
                        IsChecked="True"
                        OffContent="Off"
                        OnContent="On" />
                    <ui:Button
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        Appearance="Accent"
                        Click="SaveSettingsButton_Click"
                        Content="Save settings" />
                    <ui:InfoBar
                        x:Name="SettingsSavedBar"
                        Margin="0,0,0,12"
                        IsClosable="True"
                        IsOpen="False"
                        Message="Your preferences were saved."
                        Severity="{x:Static uicore:InfoBarSeverity.Success}"
                        Title="Saved" />
                    <ui:HyperlinkButton
                        x:Name="SettingsFormSourceLink"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
