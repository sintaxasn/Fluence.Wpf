<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" HorizontalAlignment="Stretch">
            <TextBlock
                Margin="0,0,0,4"
                ui:TextBlockExtensions.Typography="Title"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Status" />
            <TextBlock
                Margin="0,0,0,24"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Status controls communicate progress, busy work, and contextual outcomes without interrupting the current task." />

            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="ProgressBar" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use ProgressBar for measurable work where the current value can be reported." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:ProgressBar
                        x:Name="StandardProgressBar"
                        Height="8"
                        Margin="6,12,6,12"
                        HorizontalAlignment="Stretch"
                        Maximum="100"
                        Minimum="0"
                        Value="50" />
                    <ui:Slider
                        x:Name="ProgressSlider"
                        Maximum="100"
                        Minimum="0"
                        ValueChanged="ProgressSlider_ValueChanged"
                        Value="50" />
                    <TextBlock
                        x:Name="SliderValueLabel"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,24"
                        Style="{StaticResource StateLabelStyle}"
                        Text="Value: 50" />
                    <Grid Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                Margin="6,0,6,6"
                                Style="{StaticResource StateLabelStyle}"
                                Text="Paused" />
                            <ui:ProgressBar
                                Height="8"
                                Margin="6,0,6,6"                                
                                HorizontalAlignment="Stretch"
                                Maximum="100"
                                Minimum="0"
                                ProgressMode="Paused"
                                Value="80" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Margin="6,0,6,6"                                
                                Style="{StaticResource StateLabelStyle}"
                                Text="Failure" />
                            <ui:ProgressBar
                                Height="8"
                                Margin="6,0,6,12"                                
                                HorizontalAlignment="Stretch"
                                Maximum="100"
                                Minimum="0"
                                ProgressMode="Error"
                                Value="80" />
                        </StackPanel>
                    </Grid>
                    <ui:HyperlinkButton
                        x:Name="ProgressBarValueSourceLink"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Indeterminate ProgressBar" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use indeterminate mode when work is active but no reliable percentage is available." />
            <ui:Card
                Margin="0,12,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:ProgressBar
                        x:Name="IndeterminateProgressBar"
                        Height="8"
                        Margin="6,12,6,12"
                        HorizontalAlignment="Stretch"
                        ProgressMode="Indeterminate" />
                    <StackPanel Orientation="Horizontal">
                        <ui:ToggleSwitch
                            x:Name="IndeterminateToggle"
                            Margin="6,12,12,12"
                            Checked="IndeterminateToggle_Toggled"
                            IsChecked="True"
                            Unchecked="IndeterminateToggle_Toggled" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Indeterminate" />
                    </StackPanel>
                    <ui:HyperlinkButton
                        x:Name="ProgressBarIndeterminateSourceLink"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Step Progress" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use step progress for ordered tasks where users understand the current milestone." />
            <ui:Card
                Margin="0,12,0,12"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:ProgressBar
                        x:Name="StepProgressBar"
                        Height="8"
                        Margin="6,12,6,12"
                        HorizontalAlignment="Stretch"
                        CurrentStep="1"
                        ProgressMode="StepProgress"
                        Steps="10" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Margin="6,12,12,6"
                            Click="ProgressStep_Click"
                            Content="Back"
                            Tag="Back" />
                        <ui:Button
                            Margin="6,12,16,6"
                            Appearance="Accent"
                            Click="ProgressStep_Click"
                            Content="Next"
                            Tag="Next" />
                        <TextBlock
                            x:Name="StepLabel"
                            Margin="6,12,0,6"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Step 1 of 10" />
                    </StackPanel>
                    <ui:HyperlinkButton
                        x:Name="ProgressBarStepsSourceLink"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="ProgressRing" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use ProgressRing when space is tight or when progress belongs next to compact content." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <Grid
                        Margin="0,12,0,12"
                        HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:ProgressRing
                            x:Name="IndeterminateProgressRing"
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            IsActive="True"
                            IsIndeterminate="True" />
                        <ui:ToggleSwitch
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsActive, ElementName=IndeterminateProgressRing, Mode=TwoWay}"
                            OffContent="Off"
                            OnContent="On" />
                        <TextBlock
                            x:Name="IndeterminateProgressRingLabel"
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource StateLabelStyle}"
                            Text="Indeterminate" />

                        <ui:ProgressRing
                            x:Name="DeterminateProgressRing"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            IsActive="True"
                            IsIndeterminate="False"
                            Maximum="100"
                            Minimum="0"
                            Value="50" />
                        <ui:Slider
                            x:Name="ProgressRingSlider"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="120"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Maximum="100"
                            Minimum="0"
                            ValueChanged="ProgressRingSlider_ValueChanged"
                            Value="50" />
                        <TextBlock
                            x:Name="DeterminateProgressRingLabel"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource StateLabelStyle}"
                            Text="Determinate" />

                        <ui:ProgressRing
                            x:Name="PausedProgressRing"
                            Grid.Row="0"
                            Grid.Column="2"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            Maximum="100"
                            Minimum="0"
                            IsActive="True"
                            IsIndeterminate="False"
                            Value="80"
                            ProgressState="{x:Static uicore:ProgressRingState.Paused}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource StateLabelStyle}"
                            Text="Paused" />

                        <ui:ProgressRing
                            x:Name="ErrorProgressRing"
                            Grid.Row="0"
                            Grid.Column="3"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            IsActive="True"
                            IsIndeterminate="False"
                            Maximum="100"
                            Minimum="0"
                            ProgressState="{x:Static uicore:ProgressRingState.Error}"
                            Value="80" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="3"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource StateLabelStyle}"
                            Text="Error" />
                    </Grid>
                    <ui:HyperlinkButton
                        x:Name="ProgressRingsSourceLink"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="InfoBar" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use InfoBar for inline messages that explain status, validation, or recoverable outcomes." />
            <ui:Card Padding="16" Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:InfoBar
                        x:Name="InfoBarInformational"
                        Title="Informational"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch"
                        IsOpen="True"
                        Message="This is a general information message."
                        Severity="Informational" />
                    <ui:InfoBar
                        x:Name="InfoBarSuccess"
                        Title="Success"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch"
                        IsOpen="True"
                        Message="The operation completed successfully."
                        Severity="Success" />
                    <ui:InfoBar
                        x:Name="InfoBarWarning"
                        Title="Warning"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch"
                        IsOpen="True"
                        Message="Proceed with caution."
                        Severity="Warning" />
                    <ui:InfoBar
                        x:Name="InfoBarError"
                        Title="Error"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch"
                        IsOpen="True"
                        Message="Something went wrong."
                        Severity="Error">
                        <ui:InfoBar.ActionButton>
                            <ui:Button Appearance="Accent" Content="Retry" />
                        </ui:InfoBar.ActionButton>
                    </ui:InfoBar>
                    <ui:Button
                        Margin="0,4,0,0"
                        HorizontalAlignment="Left"
                        Click="ResetInfoBars_Click"
                        Content="Reset All InfoBars" />
                    <ui:HyperlinkButton
                        x:Name="InfoBarsSourceLink"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
