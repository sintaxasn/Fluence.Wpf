<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    d:DesignHeight="800"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" HorizontalAlignment="Stretch">
            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="ProgressBar" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Standard progress bar bound to a slider." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:ProgressBar
                        x:Name="StandardProgressBar"
                        Height="8"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Stretch"
                        Maximum="100"
                        Minimum="0"
                        Value="45" />
                    <ui:Slider
                        x:Name="ProgressSlider"
                        IsSnapToTickEnabled="False"
                        Maximum="100"
                        Minimum="0"
                        TickFrequency="5"
                        ValueChanged="ProgressSlider_ValueChanged"
                        Value="45" />
                    <TextBlock
                        x:Name="SliderValueLabel"
                        Style="{StaticResource StateLabelStyle}"
                        Text="Value: 45" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Indeterminate ProgressBar" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Toggle indeterminate mode on or off." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:ProgressBar
                        x:Name="IndeterminateProgressBar"
                        Height="8"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Stretch"
                        ProgressMode="Indeterminate" />
                    <StackPanel Orientation="Horizontal">
                        <ui:ToggleSwitch
                            x:Name="IndeterminateToggle"
                            Margin="0,0,12,0"
                            Checked="IndeterminateToggle_Toggled"
                            IsChecked="True"
                            Unchecked="IndeterminateToggle_Toggled" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Indeterminate" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Step Progress" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Navigate through steps with Back and Next buttons." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:ProgressBar
                        x:Name="StepProgressBar"
                        Height="8"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Stretch"
                        CurrentStep="1"
                        ProgressMode="StepProgress"
                        Steps="5" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,12,0"
                            Click="ProgressStep_Click"
                            Content="Back"
                            Tag="Back" />
                        <ui:Button
                            Margin="0,0,16,0"
                            Appearance="Accent"
                            Click="ProgressStep_Click"
                            Content="Next"
                            Tag="Next" />
                        <TextBlock
                            x:Name="StepLabel"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Step 1 of 5" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="ProgressRing" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Circular progress indicators: indeterminate spinner with on/off toggle, determinate arc with slider, and inactive state." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <UniformGrid HorizontalAlignment="Stretch" Columns="3">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:ProgressRing
                            x:Name="IndeterminateProgressRing"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            IsActive="True"
                            IsIndeterminate="True" />
                        <ui:ToggleSwitch
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            IsChecked="{Binding IsActive, ElementName=IndeterminateProgressRing, Mode=TwoWay}"
                            OffContent="Off"
                            OnContent="On" />
                        <TextBlock
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource StateLabelStyle}"
                            Text="Indeterminate" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <ui:ProgressRing
                            x:Name="DeterminateProgressRing"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            IsActive="True"
                            IsIndeterminate="False"
                            Maximum="100"
                            Minimum="0"
                            Value="50" />
                        <ui:Slider
                            x:Name="ProgressRingSlider"
                            Width="120"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Maximum="100"
                            Minimum="0"
                            ValueChanged="ProgressRingSlider_ValueChanged"
                            Value="50" />
                        <TextBlock
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource StateLabelStyle}"
                            Text="Determinate" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <ui:ProgressRing
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            IsActive="False" />
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource StateLabelStyle}"
                            Text="Inactive" />
                    </StackPanel>
                </UniformGrid>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="InfoBar" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Contextual notifications with severity levels and optional actions." />
            <ui:Card Padding="16" Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:InfoBar
                        x:Name="InfoBarInformational"
                        Title="Informational"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch"
                        IsOpen="True"
                        Message="This is a general information message."
                        Severity="Informational" />
                    <ui:InfoBar
                        x:Name="InfoBarSuccess"
                        Title="Success"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch"
                        IsOpen="True"
                        Message="The operation completed successfully."
                        Severity="Success" />
                    <ui:InfoBar
                        x:Name="InfoBarWarning"
                        Title="Warning"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch"
                        IsOpen="True"
                        Message="Proceed with caution."
                        Severity="Warning" />
                    <ui:InfoBar
                        x:Name="InfoBarError"
                        Title="Error"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch"
                        IsOpen="True"
                        Message="Something went wrong."
                        Severity="Error">
                        <ui:InfoBar.ActionButton>
                            <ui:Button Appearance="Accent" Content="Retry" />
                        </ui:InfoBar.ActionButton>
                    </ui:InfoBar>
                    <ui:Button
                        Margin="0,4,0,0"
                        Click="ResetInfoBars_Click"
                        Content="Reset All InfoBars" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
