<UserControl x:Class="Fluence.Wpf.Demo.Pages.GalleryDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800" d:DesignWidth="900"
    mc:Ignorable="d">
                    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24" HorizontalAlignment="Stretch">
                            <TextBlock
                                Margin="0,0,0,4"
                                Style="{StaticResource SectionHeaderStyle}"
                                Text="ListView"
                                />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Animated list with add/remove controls and empty state." />
                            <ui:Card
                                Margin="0,0,0,16"
                                Padding="16"
                                Variant="{x:Static uicore:CardVariant.Default}"
                                >
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:ListView
                                            x:Name="DemoListView"
                                            Grid.Column="0"
                                            Height="230"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            >
                                            <ui:ListView.EmptyContent>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="No items - click Add to begin"
                                                    />
                                            </ui:ListView.EmptyContent>
                                            <ListViewItem Content="Ana Bowman" />
                                            <ListViewItem Content="Shawn Hughes" />
                                            <ListViewItem Content="Oscar Ward" />
                                            <ListViewItem Content="Madison Butler" />
                                            <ListViewItem Content="Graham Barnes" />
                                            <ListViewItem Content="Anthony Ivanov" />
                                            <ListViewItem Content="Michael Peltier" />
                                            <ListViewItem Content="Sofia Chen" />
                                        </ui:ListView>
                                        <ui:ListView
                                            x:Name="DemoListViewDetail"
                                            Grid.Column="2"
                                            Height="230"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            >
                                            <ListViewItem Tag="Ana Bowman|Support Engineer">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:FontIcon
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE77B;"
                                                        IconFontSize="20"
                                                        />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold" Text="Ana Bowman" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="Support Engineer"
                                                            />
                                                    </StackPanel>
                                                </Grid>
                                            </ListViewItem>
                                            <ListViewItem Tag="Shawn Hughes|Platform Specialist">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:FontIcon
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE77B;"
                                                        IconFontSize="20"
                                                        />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold" Text="Shawn Hughes" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="Platform Specialist"
                                                            />
                                                    </StackPanel>
                                                </Grid>
                                            </ListViewItem>
                                            <ListViewItem Tag="Oscar Ward|DevOps Lead">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:FontIcon
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE77B;"
                                                        IconFontSize="20"
                                                        />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold" Text="Oscar Ward" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="DevOps Lead"
                                                            />
                                                    </StackPanel>
                                                </Grid>
                                            </ListViewItem>
                                            <ListViewItem Tag="Madison Butler|UX Designer">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:FontIcon
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE77B;"
                                                        IconFontSize="20"
                                                        />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold" Text="Madison Butler" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="UX Designer"
                                                            />
                                                    </StackPanel>
                                                </Grid>
                                            </ListViewItem>
                                            <ListViewItem Tag="Graham Barnes|Security Analyst">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:FontIcon
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE77B;"
                                                        IconFontSize="20"
                                                        />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold" Text="Graham Barnes" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="Security Analyst"
                                                            />
                                                    </StackPanel>
                                                </Grid>
                                            </ListViewItem>
                                            <ListViewItem Tag="Anthony Ivanov|Backend Developer">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:FontIcon
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE77B;"
                                                        IconFontSize="20"
                                                        />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold" Text="Anthony Ivanov" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="Backend Developer"
                                                            />
                                                    </StackPanel>
                                                </Grid>
                                            </ListViewItem>
                                            <ListViewItem Tag="Michael Peltier|Project Manager">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:FontIcon
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE77B;"
                                                        IconFontSize="20"
                                                        />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold" Text="Michael Peltier" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="Project Manager"
                                                            />
                                                    </StackPanel>
                                                </Grid>
                                            </ListViewItem>
                                            <ListViewItem Tag="Sofia Chen|Data Scientist">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:FontIcon
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE77B;"
                                                        IconFontSize="20"
                                                        />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold" Text="Sofia Chen" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="Data Scientist"
                                                            />
                                                    </StackPanel>
                                                </Grid>
                                            </ListViewItem>
                                        </ui:ListView>
                                    </Grid>
                                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Appearance="Accent"
                                            Click="AddListItem_Click"
                                            Content="Add"
                                            />
                                        <ui:Button Click="RemoveListItem_Click" Content="Remove" />
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>

                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Expander" />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Collapsible content sections with header and chevron." />
                            <ui:Card
                                Margin="0,0,0,16"
                                Padding="16"
                                Variant="{x:Static uicore:CardVariant.Default}"
                                >
                                <StackPanel>
                                    <ui:Expander Margin="0,0,0,8" Header="Click to expand">
                                        <TextBlock
                                            Margin="8"
                                            Text="This content is revealed when the expander is opened. It can contain any UI elements."
                                            TextWrapping="Wrap"
                                            />
                                    </ui:Expander>
                                    <ui:Expander Header="Initially expanded" IsExpanded="True">
                                        <StackPanel Margin="8">
                                            <TextBlock Text="Expanders can start in the expanded state." TextWrapping="Wrap" />
                                            <ui:Button Margin="0,8,0,0" Content="Action" />
                                        </StackPanel>
                                    </ui:Expander>
                                </StackPanel>
                            </ui:Card>

                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Card Variants" />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Four visual variants plus clickable and minimal cards." />
                            <ui:Card
                                Margin="0,0,0,16"
                                Padding="16"
                                Variant="{x:Static uicore:CardVariant.Default}"
                                >
                                <UniformGrid Margin="0,0,0,16" Columns="2">
                                    <ui:Card
                                        MinHeight="100"
                                        Margin="0,0,16,16"
                                        Padding="18"
                                        Header="Default"
                                        Variant="{x:Static uicore:CardVariant.Default}"
                                        >
                                        <TextBlock Text="Default card variant" TextWrapping="Wrap" />
                                    </ui:Card>
                                    <ui:Card
                                        MinHeight="100"
                                        Margin="0,0,0,16"
                                        Padding="18"
                                        Header="Outlined"
                                        Variant="{x:Static uicore:CardVariant.Outlined}"
                                        >
                                        <TextBlock Text="Outlined card variant" TextWrapping="Wrap" />
                                    </ui:Card>
                                    <ui:Card
                                        MinHeight="100"
                                        Margin="0,0,16,0"
                                        Padding="18"
                                        Header="Filled"
                                        Variant="{x:Static uicore:CardVariant.Filled}"
                                        >
                                        <TextBlock Text="Filled card variant" TextWrapping="Wrap" />
                                    </ui:Card>
                                    <ui:Card
                                        MinHeight="100"
                                        Padding="18"
                                        Header="Subtle"
                                        Variant="{x:Static uicore:CardVariant.Subtle}"
                                        >
                                        <TextBlock Text="Subtle card variant" TextWrapping="Wrap" />
                                    </ui:Card>
                                </UniformGrid>
                            </ui:Card>

                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Typography" />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="WinUI 3 typography scale via TextBlockExtensions.Typography." />
                            <ui:Card
                                Margin="0,0,0,16"
                                Padding="16"
                                Variant="{x:Static uicore:CardVariant.Default}"
                                >
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        ui:TextBlockExtensions.Typography="Display"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="Display"
                                        />
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        ui:TextBlockExtensions.Typography="TitleLarge"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="TitleLarge"
                                        />
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        ui:TextBlockExtensions.Typography="Title"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="Title"
                                        />
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        ui:TextBlockExtensions.Typography="Subtitle"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="Subtitle"
                                        />
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        ui:TextBlockExtensions.Typography="BodyLarge"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="BodyLarge"
                                        />
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        ui:TextBlockExtensions.Typography="BodyStrong"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="BodyStrong"
                                        />
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        ui:TextBlockExtensions.Typography="Body"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="Body"
                                        />
                                    <TextBlock
                                        ui:TextBlockExtensions.Typography="Caption"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="Caption"
                                        />
                                    <TextBlock
                                        x:Name="FontDetectionLabel"
                                        Margin="0,10,0,0"
                                        Style="{StaticResource StateLabelStyle}"
                                        Text="FontFamily: (loading...)"
                                        />
                                </StackPanel>
                            </ui:Card>

                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="FontIcon Demos" />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Filled, outline, spinning, and interactive icon variants using Segoe Fluent Icons." />
                            <ui:Card Padding="16" Variant="{x:Static uicore:CardVariant.Default}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Width="100" Margin="0,0,24,0">
                                        <ui:Border
                                            Width="128"
                                            Height="128"
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource IconGalleryCardStyle}"
                                            >
                                            <ui:FontIcon
                                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                Glyph="&#xE735;"
                                                IconFontSize="32"
                                                />
                                        </ui:Border>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource StateLabelStyle}"
                                            Text="Filled"
                                            />
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,24,0">
                                        <ui:Border
                                            Width="128"
                                            Height="128"
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource IconGalleryCardStyle}"
                                            >
                                            <ui:FontIcon Glyph="&#xE734;" IconFontSize="32" />
                                        </ui:Border>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource StateLabelStyle}"
                                            Text="Outline"
                                            />
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,24,0">
                                        <ui:Border
                                            Width="128"
                                            Height="128"
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource IconGalleryCardStyle}"
                                            >
                                            <ui:FontIcon
                                                Glyph="&#xE72C;"
                                                IconFontSize="32"
                                                IsSpinning="True"
                                                />
                                        </ui:Border>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource StateLabelStyle}"
                                            Text="Spinning"
                                            />
                                    </StackPanel>
                                    <StackPanel Width="100">
                                        <ui:Button
                                            Width="128"
                                            Height="128"
                                            HorizontalAlignment="Center"
                                            Click="FontIconDemo_Click"
                                            >
                                            <ui:FontIcon
                                                x:Name="ClickableFontIcon"
                                                Glyph="&#xE72A;"
                                                IconFontSize="32"
                                                />
                                        </ui:Button>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource StateLabelStyle}"
                                            Text="Clickable"
                                            />
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ui:SmoothScrollViewer>
</UserControl>
