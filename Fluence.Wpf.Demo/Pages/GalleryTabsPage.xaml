<UserControl x:Class="Fluence.Wpf.Demo.Pages.GalleryTabsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled"
                           VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Margin="0,0,0,4"
                       Style="{StaticResource SectionHeaderStyle}"
                       Text="TabControl" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}"
                       Text="WinUI-styled classic tabs with animated selection indicator and WinUI typography." />
            <ui:Card Margin="0,0,0,16"
                     Padding="16"
                     Variant="{x:Static uicore:CardVariant.Default}">
                <TabControl Height="180">
                    <TabItem Header="General">
                        <StackPanel Margin="16">
                            <TextBlock FontWeight="SemiBold"
                                       Text="General" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Primary panel content."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Details">
                        <StackPanel Margin="16">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Details" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Secondary content shown when this tab is selected."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="About">
                        <StackPanel Margin="16">
                            <TextBlock FontWeight="SemiBold"
                                       Text="About" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Metadata and attribution for this surface."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </ui:Card>

            <TextBlock Margin="0,8,0,4"
                       Style="{StaticResource SectionHeaderStyle}"
                       Text="TabView" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}"
                       Text="Multi-document surface with per-tab close, add-tab (+) affordance, and WinUI selection indicator." />
            <ui:Card Margin="0,0,0,16"
                     Padding="16"
                     Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:TabView x:Name="DemoTabView"
                                Height="240"
                                AddTabButtonClick="DemoTabView_AddTabButtonClick"
                                CloseButtonOverlayMode="Auto"
                                TabCloseRequested="DemoTabView_TabCloseRequested">
                        <ui:TabViewItem Header="Document 1"
                                        IsSelected="True">
                            <ui:TabViewItem.Icon>
                                <ui:FontIcon Glyph="&#xE8A5;"
                                             IconFontSize="16" />
                            </ui:TabViewItem.Icon>
                            <StackPanel Margin="16">
                                <TextBlock FontWeight="SemiBold"
                                           Text="Document 1" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Click the × to close a tab, or + to open a new one."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:TabViewItem>
                        <ui:TabViewItem Header="Document 2">
                            <ui:TabViewItem.Icon>
                                <ui:FontIcon Glyph="&#xE8A5;"
                                             IconFontSize="16" />
                            </ui:TabViewItem.Icon>
                            <StackPanel Margin="16">
                                <TextBlock FontWeight="SemiBold"
                                           Text="Document 2" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Each tab is its own editable surface."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:TabViewItem>
                        <ui:TabViewItem Header="Welcome"
                                        IsClosable="False">
                            <ui:TabViewItem.Icon>
                                <ui:FontIcon Glyph="&#xE80F;"
                                             IconFontSize="16" />
                            </ui:TabViewItem.Icon>
                            <StackPanel Margin="16">
                                <TextBlock FontWeight="SemiBold"
                                           Text="Welcome" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Tabs can be pinned by setting IsClosable to false."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:TabViewItem>
                    </ui:TabView>
                    <TextBlock x:Name="DemoTabViewStatus"
                               Margin="0,12,0,0"
                               Style="{StaticResource StateLabelStyle}"
                               Text="Tabs: 3" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
