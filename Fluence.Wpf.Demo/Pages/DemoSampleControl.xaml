<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.DemoSampleControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <fluence:Card
            x:Name="SampleCard"
            Grid.Row="0"
            Padding="16"
            CornerRadius="8,8,0,0"
            Variant="Default">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    x:Name="HeaderPanel"
                    Grid.Row="0"
                    Margin="0,0,0,12">
                    <TextBlock
                        x:Name="TitleTextBlock"
                        Margin="0,0,0,4"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding Title, ElementName=Root}" />
                    <TextBlock
                        x:Name="DescriptionTextBlock"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Description, ElementName=Root}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ContentPresenter
                    x:Name="SampleContentPresenter"
                    Grid.Row="1"
                    Content="{Binding SampleContent, ElementName=Root}" />
            </Grid>
        </fluence:Card>

        <fluence:Expander
            x:Name="SourceExpander"
            Grid.Row="1"
            Margin="0"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,8,8"
            Expanded="SourceExpander_Expanded"
            Header="Source">
            <fluence:TabView
                x:Name="SourceTabs"
                Margin="8,16,8,8"
                IsAddTabButtonVisible="False" />
        </fluence:Expander>
    </Grid>
</UserControl>
