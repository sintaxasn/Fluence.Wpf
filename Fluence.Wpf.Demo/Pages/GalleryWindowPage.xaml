<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryWindowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" HorizontalAlignment="Stretch">
            <TextBlock
                Margin="0,0,0,4"
                ui:TextBlockExtensions.Typography="Title"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Window" />
            <TextBlock
                Margin="0,0,0,24"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="These examples configure the demo FluenceWindow at runtime: theme, accent color, backdrop material, caption buttons, and title visibility." />

            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="Theme, backdrop, and accent" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Switch application theme, opt in to system theme watching, choose the backdrop, or apply a custom accent swatch." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                Margin="0,0,0,8"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Theme" />
                            <WrapPanel Margin="0,0,0,8">
                                <ui:RadioButton
                                    x:Name="ThemeLight"
                                    Margin="0,0,12,8"
                                    Checked="ThemeRadioButton_Checked"
                                    Content="Light"
                                    GroupName="ThemeGroup" />
                                <ui:RadioButton
                                    x:Name="ThemeDark"
                                    Margin="0,0,12,8"
                                    Checked="ThemeRadioButton_Checked"
                                    Content="Dark"
                                    GroupName="ThemeGroup" />
                                <ui:RadioButton
                                    x:Name="ThemeHighContrast"
                                    Margin="0,0,12,8"
                                    Checked="ThemeRadioButton_Checked"
                                    Content="HighContrast"
                                    GroupName="ThemeGroup" />
                                <ui:RadioButton
                                    x:Name="ThemeAuto"
                                    Margin="0,0,12,8"
                                    Checked="ThemeRadioButton_Checked"
                                    Content="Auto"
                                    GroupName="ThemeGroup"
                                    IsChecked="True" />
                            </WrapPanel>
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <ui:ToggleSwitch
                                    x:Name="ThemeWatcherToggle"
                                    Margin="0,0,10,0"
                                    Checked="SystemThemeWatcher_Toggled"
                                    IsChecked="True"
                                    Unchecked="SystemThemeWatcher_Toggled" />
                                <TextBlock
                                    x:Name="SystemThemeLabel"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Watching: Yes" />
                            </StackPanel>
                            <TextBlock
                                x:Name="ThemeStateLabel"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Current: Auto" />
                            <TextBlock
                                Margin="0,16,0,6"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Backdrop" />
                            <ui:ComboBox
                                x:Name="BackdropCombo"
                                Width="220"
                                HorizontalAlignment="Left"
                                SelectedIndex="2"
                                SelectionChanged="BackdropCombo_SelectionChanged">
                                <ComboBoxItem Content="Auto" />
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Mica" />
                                <ComboBoxItem Content="Acrylic" />
                                <ComboBoxItem Content="Tabbed" />
                            </ui:ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Margin="0,0,0,8"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Accent color" />
                            <UniformGrid
                                x:Name="AccentSwatchRow"
                                Columns="7"
                                Margin="0,0,0,8"
                                Rows="1">
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Background="#E80000"
                                    Click="AccentSwatch_Click"
                                    Style="{StaticResource AccentSwatchStyle}"
                                    Tag="#E80000" />
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Background="#F58809"
                                    Click="AccentSwatch_Click"
                                    Style="{StaticResource AccentSwatchStyle}"
                                    Tag="#F58809" />
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Background="#F5E70C"
                                    Click="AccentSwatch_Click"
                                    Style="{StaticResource AccentSwatchStyle}"
                                    Tag="#F5E70C" />
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Background="#2BDE11"
                                    Click="AccentSwatch_Click"
                                    Style="{StaticResource AccentSwatchStyle}"
                                    Tag="#2BDE11" />
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Background="#09C4DE"
                                    Click="AccentSwatch_Click"
                                    Style="{StaticResource AccentSwatchStyle}"
                                    Tag="#09C4DE" />
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Background="#AA04DE"
                                    Click="AccentSwatch_Click"
                                    Style="{StaticResource AccentSwatchStyle}"
                                    Tag="#AA04DE" />
                                <ui:Button
                                    Margin="0,0,0,0"
                                    Background="#FF00E8"
                                    Click="AccentSwatch_Click"
                                    Style="{StaticResource AccentSwatchStyle}"
                                    Tag="#FF00E8" />
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button
                                    MinWidth="80"
                                    Margin="0,0,10,0"
                                    Click="SystemAccent_Click"
                                    Content="System" />
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Status:" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="Accent: System" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <ui:HyperlinkButton
                        x:Name="ThemeAndAccentSourceLink"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="Caption buttons" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Set individual caption button availability and title identity visibility." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Caption buttons" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Minimize" />
                        <ui:ComboBox
                            x:Name="MinimizeVisibilityCombo"
                            Grid.Column="1"
                            Width="110"
                            SelectionChanged="CaptionVisibilityCombo_SelectionChanged">
                            <ComboBoxItem Content="Default" IsSelected="True" />
                            <ComboBoxItem Content="Enable" />
                            <ComboBoxItem Content="Disable" />
                            <ComboBoxItem Content="Hidden" />
                            <ComboBoxItem Content="Collapsed" />
                        </ui:ComboBox>
                        <TextBlock
                            Grid.Column="3"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Maximize" />
                        <ui:ComboBox
                            x:Name="MaximizeVisibilityCombo"
                            Grid.Column="4"
                            Width="110"
                            SelectionChanged="CaptionVisibilityCombo_SelectionChanged">
                            <ComboBoxItem Content="Default" IsSelected="True" />
                            <ComboBoxItem Content="Enable" />
                            <ComboBoxItem Content="Disable" />
                            <ComboBoxItem Content="Hidden" />
                            <ComboBoxItem Content="Collapsed" />
                        </ui:ComboBox>
                        <TextBlock
                            Grid.Column="6"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Close" />
                        <ui:ComboBox
                            x:Name="CloseVisibilityCombo"
                            Grid.Column="7"
                            Width="110"
                            SelectionChanged="CaptionVisibilityCombo_SelectionChanged">
                            <ComboBoxItem Content="Default" IsSelected="True" />
                            <ComboBoxItem Content="Enable" />
                            <ComboBoxItem Content="Disable" />
                            <ComboBoxItem Content="Hidden" />
                            <ComboBoxItem Content="Collapsed" />
                        </ui:ComboBox>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:CheckBox
                            x:Name="ShowWindowIconToggle"
                            Margin="0,0,14,0"
                            Checked="WindowChromeToggle_Changed"
                            Content="Show Icon"
                            IsChecked="True"
                            Unchecked="WindowChromeToggle_Changed" />
                        <ui:CheckBox
                            x:Name="ShowWindowTitleToggle"
                            Checked="WindowChromeToggle_Changed"
                            Content="Show Title"
                            IsChecked="True"
                            Unchecked="WindowChromeToggle_Changed" />
                    </StackPanel>
                    <ui:HyperlinkButton
                        x:Name="CaptionButtonsSourceLink"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
