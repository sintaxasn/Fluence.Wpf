<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryInputsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" HorizontalAlignment="Stretch">
            <TextBlock
                Margin="0,0,0,4"
                ui:TextBlockExtensions.Typography="Title"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Inputs" />
            <TextBlock
                Margin="0,0,0,24"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Input controls collect freeform text, protected text, numbers, and ranged values." />

            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="TextBox" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use text boxes for short text entry. Add icons, clear buttons, and limits when they clarify the expected input." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:TextBox
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        PlaceholderText="Basic text box..." />
                    <ui:TextBox
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        PlaceholderText="Search">
                        <ui:TextBox.Icon>
                            <ui:FontIcon Glyph="&#xE721;" IconFontSize="14" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>
                    <ui:TextBox
                        x:Name="CharCountTextBox"
                        Width="480"
                        Margin="0,0,0,4"
                        HorizontalAlignment="Left"
                        MaxLength="40"
                        PlaceholderText="Limited to 40 characters..."
                        TextChanged="CharCountTextBox_TextChanged" />
                    <TextBlock
                        x:Name="CharCountLabel"
                        Margin="0,0,0,12"
                        Style="{StaticResource StateLabelStyle}"
                        Text="Characters: 0" />
                    <ui:HyperlinkButton
                        x:Name="TextBoxInputSourceLink"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Validation" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Show helper text for guidance and validation states for committed feedback." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:TextBox
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        HelperText="Helper text can explain format before validation."
                        PlaceholderText="With helper text" />
                    <ui:TextBox
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        Text="Valid input"
                        ValidationMessage="Looks good."
                        ValidationState="{x:Static uicore:ValidationState.Success}" />
                    <ui:TextBox
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        Text="Check this value"
                        ValidationMessage="Review this before continuing."
                        ValidationState="{x:Static uicore:ValidationState.Warning}" />
                    <ui:TextBox
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        Text="Bad value"
                        ValidationMessage="Please fix this field."
                        ValidationState="{x:Static uicore:ValidationState.Error}" />
                    <ui:HyperlinkButton
                        x:Name="TextBoxValidationSourceLink"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="PasswordBox" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use password boxes for protected text entry, with reveal and strength affordances when appropriate." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:PasswordBox
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        PlaceholderText="Enter password..."
                        RevealButtonEnabled="True" />
                    <ui:PasswordBox
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        Password="CorrectHorse7!"
                        RevealButtonEnabled="True" />
                    <ui:PasswordBox
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        PlaceholderText="Disabled" />
                    <ui:HyperlinkButton
                        x:Name="PasswordBoxInputSourceLink"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="NumberBox" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use number boxes for numeric entry with optional spin buttons, bounds, and supporting descriptions." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,12">
                        <ui:NumberBox
                            Width="260"
                            Margin="0,0,16,12"
                            Header="Inline"
                            Maximum="100"
                            Minimum="0"
                            SpinButtonPlacementMode="Inline"
                            Value="5" />
                        <ui:NumberBox
                            Width="260"
                            Margin="0,0,16,12"
                            Header="Compact"
                            Maximum="100"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            Value="25" />
                        <ui:NumberBox
                            Width="260"
                            Margin="0,0,16,12"
                            Header="Keyboard only"
                            Maximum="100"
                            Minimum="0"
                            SpinButtonPlacementMode="Hidden"
                            Value="50" />
                        <ui:NumberBox
                            Width="260"
                            Margin="0,0,16,12"
                            Header="Disabled"
                            IsEnabled="False"
                            Value="42" />
                    </WrapPanel>
                    <ui:HyperlinkButton
                        x:Name="NumberBoxInputSourceLink"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Slider" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use sliders when a relative value is easier to choose visually than typing a precise number." />
            <ui:Card Padding="20" Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Default" />
                    <ui:Slider
                        Margin="0,0,0,14"
                        Maximum="100"
                        Minimum="0"
                        Value="35" />
                    <TextBlock
                        Margin="0,0,0,6"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Snapped to ticks" />
                    <ui:Slider
                        Margin="0,0,0,14"
                        IsSnapToTickEnabled="True"
                        Maximum="10"
                        Minimum="0"
                        TickFrequency="1"
                        Value="4" />
                    <Grid
                        MaxWidth="292"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,6"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Vertical" />
                            <ui:Slider
                                Height="210"
                                Maximum="100"
                                Minimum="0"
                                Orientation="Vertical"
                                Value="40" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,6"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Disabled" />
                            <ui:Slider
                                Height="210"
                                IsEnabled="False"
                                Maximum="100"
                                Minimum="0"
                                Orientation="Vertical"
                                Value="25" />
                        </StackPanel>
                    </Grid>
                    <ui:HyperlinkButton
                        x:Name="SliderInputSourceLink"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
