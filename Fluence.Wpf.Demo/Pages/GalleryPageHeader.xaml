    Shared gallery page header, modelled on the WinUI 3 Gallery's Controls/PageHeader.xaml:
    a page title on the left, and a row of default-appearance action buttons on the right
    (Documentation, Toggle theme, Favorite). See GalleryPageHeader.xaml.cs.
-->
<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryPageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluence="http://schemas.fluencewpf.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="TitleTextBlock"
            Grid.Column="0"
            VerticalAlignment="Center"
            Style="{StaticResource PageTitleStyle}"
            Text="{Binding Title, ElementName=Root}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />

        <fluence:StackPanel
            Grid.Column="1"
            Margin="{DynamicResource DemoInlineControlGapMargin}"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="{DynamicResource DemoPageHeaderActionSpacing}">
            <fluence:Button
                x:Name="DocsButton"
                MinWidth="{DynamicResource DemoCopyButtonMinWidth}"
                Padding="{DynamicResource DemoSourceCopyButtonPadding}"
                AutomationProperties.Name="Documentation"
                Click="DocsButton_Click"
                ToolTip="Documentation">
                <fluence:Button.Icon>
                    <fluence:FontIcon Glyph="&#xE8A5;" IconFontSize="16" />
                </fluence:Button.Icon>
            </fluence:Button>
            <fluence:Button
                x:Name="ThemeToggleButton"
                MinWidth="{DynamicResource DemoCopyButtonMinWidth}"
                Padding="{DynamicResource DemoSourceCopyButtonPadding}"
                AutomationProperties.Name="Toggle theme"
                Click="ThemeToggleButton_Click"
                ToolTip="Toggle theme">
                <fluence:Button.Icon>
                    <fluence:FontIcon Glyph="&#xE793;" IconFontSize="16" />
                </fluence:Button.Icon>
            </fluence:Button>
            <fluence:ToggleButton
                x:Name="FavoriteToggleButton"
                MinWidth="{DynamicResource DemoCopyButtonMinWidth}"
                Padding="{DynamicResource DemoSourceCopyButtonPadding}"
                AutomationProperties.Name="Add to favorites"
                Checked="FavoriteToggleButton_CheckedChanged"
                ToolTip="Add to favorites"
                Unchecked="FavoriteToggleButton_CheckedChanged">
                <fluence:FontIcon x:Name="FavoriteIcon" Glyph="&#xE734;" IconFontSize="16" />
            </fluence:ToggleButton>
        </fluence:StackPanel>
    </Grid>
</UserControl>
