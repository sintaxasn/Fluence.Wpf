<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GallerySelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28" HorizontalAlignment="Stretch">
            <TextBlock
                Margin="0,0,0,4"
                ui:TextBlockExtensions.Typography="Title"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Selection" />
            <TextBlock
                Margin="0,0,0,24"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Selection controls let people choose one or more options, switch settings on or off, or pick a value from a compact list." />

            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="CheckBox" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use check boxes for independent options. Add three-state only when an indeterminate value has meaning." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,16">
                        <ui:CheckBox
                            x:Name="TwoStateCheckBox"
                            Margin="0,0,32,10"
                            Content="Two-state checkbox"
                            IsChecked="True" />
                        <ui:CheckBox
                            x:Name="ThreeStateCheckBox"
                            Margin="0,0,32,10"
                            Content="Three-state checkbox"
                            IsChecked="{x:Null}"
                            IsThreeState="True" />
                        <ui:CheckBox
                            Margin="0,0,32,10"
                            Content="Disabled"
                            IsChecked="True"
                            IsEnabled="False" />
                    </WrapPanel>
                    <StackPanel Margin="0,0,0,12">
                        <ui:CheckBox
                            x:Name="SelectAllCheckBox"
                            Margin="0,0,0,8"
                            Checked="SelectAllCheckBox_Changed"
                            Content="Select all"
                            Indeterminate="SelectAllCheckBox_Changed"
                            IsThreeState="True"
                            Unchecked="SelectAllCheckBox_Changed" />
                        <ui:CheckBox
                            x:Name="OptionOneCheckBox"
                            Margin="24,0,0,8"
                            Checked="OptionCheckBox_Changed"
                            Content="Option 1"
                            Unchecked="OptionCheckBox_Changed" />
                        <ui:CheckBox
                            x:Name="OptionTwoCheckBox"
                            Margin="24,0,0,8"
                            Checked="OptionCheckBox_Changed"
                            Content="Option 2"
                            Unchecked="OptionCheckBox_Changed" />
                        <ui:CheckBox
                            x:Name="OptionThreeCheckBox"
                            Margin="24,0,0,0"
                            Checked="OptionCheckBox_Changed"
                            Content="Option 3"
                            Unchecked="OptionCheckBox_Changed" />
                    </StackPanel>
                    <ui:HyperlinkButton
                        x:Name="CheckBoxStatesSourceLink"
                        HorizontalAlignment="Right"
                        Content="Source"
                        Style="{StaticResource DemoSourceLinkButtonStyle}" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="RadioButton" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use radio buttons when people must choose exactly one option from a visible group." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Basic group" />
                    <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                        <ui:RadioButton
                            Margin="0,0,16,0"
                            Content="Option A"
                            GroupName="BasicGroup"
                            IsChecked="True" />
                        <ui:RadioButton
                            Margin="0,0,16,0"
                            Content="Option B"
                            GroupName="BasicGroup" />
                        <ui:RadioButton Content="Option C" GroupName="BasicGroup" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="With descriptions" />
                    <ui:RadioButton
                        Margin="0,0,0,8"
                        Content="Standard"
                        Description="Uses default application settings"
                        GroupName="DescGroup"
                        IsChecked="True" />
                    <ui:RadioButton
                        Margin="0,0,0,8"
                        Content="Custom"
                        Description="Allows manual configuration"
                        GroupName="DescGroup" />
                    <ui:RadioButton
                        Margin="0,0,0,12"
                        Content="Advanced"
                        Description="Expert-level options"
                        GroupName="DescGroup" />
                    <ui:HyperlinkButton
                        x:Name="RadioButtonGroupsSourceLink"
                        HorizontalAlignment="Right"
                        Content="Source"
                        Style="{StaticResource DemoSourceLinkButtonStyle}" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="ToggleSwitch" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use toggle switches for settings that take effect immediately." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,18" Orientation="Horizontal">
                        <ui:ToggleSwitch
                            x:Name="SimpleToggleSwitch"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            IsChecked="True" />
                        <TextBlock
                            x:Name="SimpleToggleStateText"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="On" />
                    </StackPanel>
                    <TextBlock
                        x:Name="WorkToggleHeaderText"
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Toggle work" />
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <ui:ToggleSwitch
                            x:Name="WorkToggleSwitch"
                            VerticalAlignment="Center"
                            IsChecked="True" />
                        <TextBlock
                            x:Name="WorkToggleStateText"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="On" />
                        <ui:ProgressRing
                            x:Name="WorkToggleProgressRing"
                            Width="36"
                            Height="36"
                            Margin="24,0,0,0"
                            VerticalAlignment="Center"
                            IsActive="{Binding IsChecked, ElementName=WorkToggleSwitch}"
                            IsIndeterminate="True" />
                    </StackPanel>
                    <ui:HyperlinkButton
                        x:Name="ToggleSwitchStatesSourceLink"
                        HorizontalAlignment="Right"
                        Content="Source"
                        Style="{StaticResource DemoSourceLinkButtonStyle}" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="RatingControl" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use rating when a compact ordered preference is more natural than a numeric input." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:RatingControl
                        x:Name="RatingSample"
                        Margin="0,0,0,14"
                        Caption="Rate the experience"
                        MaxRating="5"
                        Value="3" />
                    <ui:RatingControl
                        x:Name="ReadOnlyRatingSample"
                        Margin="0,0,0,12"
                        Caption="Read-only rating"
                        IsReadOnly="True"
                        MaxRating="5"
                        Value="4" />
                    <ui:HyperlinkButton
                        x:Name="RatingControlSourceLink"
                        HorizontalAlignment="Right"
                        Content="Source"
                        Style="{StaticResource DemoSourceLinkButtonStyle}" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="ComboBox" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use a combo box when the choices are useful but do not need to stay visible." />
            <ui:Card Padding="16" Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:ComboBox
                        x:Name="SelectionDemoCombo"
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        PlaceholderText="Choose an option..."
                        SelectedIndex="-1"
                        SelectionChanged="SelectionDemoCombo_SelectionChanged">
                        <ComboBoxItem Content="First item" />
                        <ComboBoxItem Content="Second item" />
                        <ComboBoxItem Content="Third item" />
                    </ui:ComboBox>
                    <ui:ComboBox
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        PlaceholderText="With icon"
                        SelectedIndex="-1">
                        <ui:ComboBox.Icon>
                            <ui:FontIcon Glyph="&#xE721;" IconFontSize="14" />
                        </ui:ComboBox.Icon>
                        <ComboBoxItem Content="Alpha" />
                        <ComboBoxItem Content="Beta" />
                        <ComboBoxItem Content="Gamma" />
                    </ui:ComboBox>
                    <ui:ComboBox
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        PlaceholderText="Disabled" />
                    <TextBlock
                        x:Name="ComboStateLabel"
                        Margin="0,0,0,12"
                        Style="{StaticResource StateLabelStyle}"
                        Text="Selected: none" />
                    <ui:HyperlinkButton
                        x:Name="ComboBoxSelectionSourceLink"
                        HorizontalAlignment="Right"
                        Content="Source"
                        Style="{StaticResource DemoSourceLinkButtonStyle}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
