<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GallerySelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" HorizontalAlignment="Stretch">
            <TextBlock
                Margin="0,0,0,4"
                ui:TextBlockExtensions.Typography="Title"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Selection" />
            <TextBlock
                Margin="0,0,0,24"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Selection controls let people choose one or more options, switch settings on or off, or pick a value from a compact list." />

            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="CheckBox" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use check boxes for independent options. Add three-state only when an indeterminate value has meaning." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,12">
                        <ui:CheckBox
                            Margin="0,0,32,10"
                            Content="Checked"
                            IsChecked="True" />
                        <ui:CheckBox Margin="0,0,32,10" Content="Unchecked" />
                        <ui:CheckBox
                            Margin="0,0,32,10"
                            Content="Indeterminate"
                            IsChecked="{x:Null}"
                            IsThreeState="True" />
                        <ui:CheckBox
                            Margin="0,0,32,10"
                            Content="Disabled"
                            IsChecked="True"
                            IsEnabled="False" />
                    </WrapPanel>
                    <ui:CheckBox
                        Margin="0,0,0,12"
                        Content="With description"
                        Description="Additional detail about this option" />
                    <ui:HyperlinkButton
                        x:Name="CheckBoxStatesSourceLink"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="RadioButton" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use radio buttons when people must choose exactly one option from a visible group." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Basic group" />
                    <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                        <ui:RadioButton
                            Margin="0,0,16,0"
                            Content="Option A"
                            GroupName="BasicGroup"
                            IsChecked="True" />
                        <ui:RadioButton
                            Margin="0,0,16,0"
                            Content="Option B"
                            GroupName="BasicGroup" />
                        <ui:RadioButton Content="Option C" GroupName="BasicGroup" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="With descriptions" />
                    <ui:RadioButton
                        Margin="0,0,0,8"
                        Content="Standard"
                        Description="Uses default application settings"
                        GroupName="DescGroup"
                        IsChecked="True" />
                    <ui:RadioButton
                        Margin="0,0,0,8"
                        Content="Custom"
                        Description="Allows manual configuration"
                        GroupName="DescGroup" />
                    <ui:RadioButton
                        Margin="0,0,0,12"
                        Content="Advanced"
                        Description="Expert-level options"
                        GroupName="DescGroup" />
                    <ui:HyperlinkButton
                        x:Name="RadioButtonGroupsSourceLink"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="ToggleSwitch" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use toggle switches for settings that take effect immediately." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,12">
                        <StackPanel Margin="0,0,20,10" Orientation="Horizontal">
                            <ui:ToggleSwitch
                                x:Name="DefaultToggle"
                                Margin="0,0,12,0"
                                Checked="DefaultToggle_Changed"
                                Unchecked="DefaultToggle_Changed" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Default" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,10" Orientation="Horizontal">
                            <ui:ToggleSwitch
                                Margin="0,0,12,0"
                                IsChecked="True"
                                OffContent="Off"
                                OnContent="On" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Custom On/Off" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,10" Orientation="Horizontal">
                            <ui:ToggleSwitch
                                Margin="0,0,12,0"
                                IsChecked="True"
                                IsEnabled="False" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Disabled (on)" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock
                        x:Name="ToggleStateLabel"
                        Margin="0,0,0,12"
                        Style="{StaticResource StateLabelStyle}"
                        Text="Default toggle: Off" />
                    <ui:HyperlinkButton
                        x:Name="ToggleSwitchStatesSourceLink"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="ComboBox" />
            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Use a combo box when the choices are useful but do not need to stay visible." />
            <ui:Card Padding="16" Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:ComboBox
                        x:Name="SelectionDemoCombo"
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        PlaceholderText="Choose an option..."
                        SelectedIndex="-1"
                        SelectionChanged="SelectionDemoCombo_SelectionChanged">
                        <ComboBoxItem Content="First item" />
                        <ComboBoxItem Content="Second item" />
                        <ComboBoxItem Content="Third item" />
                    </ui:ComboBox>
                    <ui:ComboBox
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        PlaceholderText="With icon"
                        SelectedIndex="-1">
                        <ui:ComboBox.Icon>
                            <ui:FontIcon Glyph="&#xE721;" IconFontSize="14" />
                        </ui:ComboBox.Icon>
                        <ComboBoxItem Content="Alpha" />
                        <ComboBoxItem Content="Beta" />
                        <ComboBoxItem Content="Gamma" />
                    </ui:ComboBox>
                    <ui:ComboBox
                        Width="480"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        PlaceholderText="Disabled" />
                    <TextBlock
                        x:Name="ComboStateLabel"
                        Margin="0,0,0,12"
                        Style="{StaticResource StateLabelStyle}"
                        Text="Selected: none" />
                    <ui:HyperlinkButton
                        x:Name="ComboBoxSelectionSourceLink"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>