<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryColorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    d:DesignHeight="800"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,16">
                <TextBlock
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="Color" />
            </Grid>

            <TabControl
                x:Name="ColorSamplesContent"
                Style="{DynamicResource TabControlStyle}">

                <!--  ═══ TEXT TAB ═══  -->
                <TabItem Header="Text" Style="{DynamicResource TabItemStyle}">
                    <StackPanel Margin="16">
                        <!--  Text  -->
                        <TextBlock Style="{StaticResource SwatchSectionHeaderStyle}" Text="Text" />
                        <TextBlock Style="{StaticResource SwatchSectionDescStyle}" Text="For UI labels and static text" />
                        <Border
                            Margin="0,0,0,24"
                            Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,16"
                                    HorizontalAlignment="Center"
                                    FontSize="48"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="Aa" />
                                <UniformGrid Columns="4" Rows="1">
                                    <Border
                                        Margin="0,0,2,0"
                                        Background="{DynamicResource TextFillColorPrimaryBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorInverseBrush}"
                                                Style="{StaticResource SwatchNameStyle}"
                                                Text="Text / Primary" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorInverseBrush}"
                                                Style="{StaticResource SwatchUsageStyle}"
                                                Text="Rest or hover" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorInverseBrush}"
                                                Style="{StaticResource SwatchKeyStyle}"
                                                Text="TextFillColorPrimaryBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="2,0,2,0"
                                        Background="{DynamicResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorInverseBrush}"
                                                Style="{StaticResource SwatchNameStyle}"
                                                Text="Text / Secondary" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorInverseBrush}"
                                                Style="{StaticResource SwatchUsageStyle}"
                                                Text="Rest or hover" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorInverseBrush}"
                                                Style="{StaticResource SwatchKeyStyle}"
                                                Text="TextFillColorSecondaryBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="2,0,2,0"
                                        Background="{DynamicResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SwatchNameStyle}" Text="Text / Tertiary" />
                                            <TextBlock Style="{StaticResource SwatchUsageStyle}" Text="Pressed only" />
                                            <TextBlock Style="{StaticResource SwatchKeyStyle}" Text="TextFillColorTertiaryBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="2,0,0,0"
                                        Background="{DynamicResource TextFillColorDisabledBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SwatchNameStyle}" Text="Text / Disabled" />
                                            <TextBlock Style="{StaticResource SwatchUsageStyle}" Text="Disabled only" />
                                            <TextBlock Style="{StaticResource SwatchKeyStyle}" Text="TextFillColorDisabledBrush" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!--  Accent Text  -->
                        <TextBlock Style="{StaticResource SwatchSectionHeaderStyle}" Text="Accent Text" />
                        <TextBlock Style="{StaticResource SwatchSectionDescStyle}" Text="Recommended for links" />
                        <Border
                            Margin="0,0,0,24"
                            Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,16"
                                    HorizontalAlignment="Center"
                                    FontSize="48"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    Text="Aa" />
                                <UniformGrid Columns="4" Rows="1">
                                    <Border
                                        Margin="0,0,2,0"
                                        Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="White"
                                                Style="{StaticResource SwatchNameStyle}"
                                                Text="Accent Text / Primary" />
                                            <TextBlock
                                                Foreground="White"
                                                Style="{StaticResource SwatchUsageStyle}"
                                                Text="Rest or hover" />
                                            <TextBlock
                                                Foreground="White"
                                                Style="{StaticResource SwatchKeyStyle}"
                                                Text="AccentTextFillColorPrimaryBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="2,0,2,0"
                                        Background="{DynamicResource AccentTextFillColorSecondaryBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="White"
                                                Style="{StaticResource SwatchNameStyle}"
                                                Text="Accent Text / Secondary" />
                                            <TextBlock
                                                Foreground="White"
                                                Style="{StaticResource SwatchUsageStyle}"
                                                Text="Rest or hover" />
                                            <TextBlock
                                                Foreground="White"
                                                Style="{StaticResource SwatchKeyStyle}"
                                                Text="AccentTextFillColorSecondaryBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="2,0,2,0"
                                        Background="{DynamicResource AccentTextFillColorTertiaryBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="White"
                                                Style="{StaticResource SwatchNameStyle}"
                                                Text="Accent Text / Tertiary" />
                                            <TextBlock
                                                Foreground="White"
                                                Style="{StaticResource SwatchUsageStyle}"
                                                Text="Pressed only" />
                                            <TextBlock
                                                Foreground="White"
                                                Style="{StaticResource SwatchKeyStyle}"
                                                Text="AccentTextFillColorTertiaryBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="2,0,0,0"
                                        Background="{DynamicResource AccentTextFillColorDisabledBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SwatchNameStyle}" Text="Accent Text / Disabled" />
                                            <TextBlock Style="{StaticResource SwatchUsageStyle}" Text="Disabled only" />
                                            <TextBlock Style="{StaticResource SwatchKeyStyle}" Text="AccentTextFillColorDisabledBrush" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!--  Text On Accent  -->
                        <TextBlock Style="{StaticResource SwatchSectionHeaderStyle}" Text="Text On Accent" />
                        <TextBlock Style="{StaticResource SwatchSectionDescStyle}" Text="Used for text on accent colored controls or fills" />
                        <Border
                            Margin="0,0,0,16"
                            Padding="16"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,16"
                                    HorizontalAlignment="Center"
                                    FontSize="48"
                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="Aa" />
                                <UniformGrid Columns="2" Rows="2">
                                    <Border
                                        Margin="0,0,2,2"
                                        Background="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                Style="{StaticResource SwatchNameStyle}"
                                                Text="Text on Accent / Primary" />
                                            <TextBlock
                                                Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                Style="{StaticResource SwatchUsageStyle}"
                                                Text="Rest or hover" />
                                            <TextBlock
                                                Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                Style="{StaticResource SwatchKeyStyle}"
                                                Text="TextOnAccentFillColorPrimaryBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="2,0,0,2"
                                        Background="{DynamicResource TextOnAccentFillColorSecondaryBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SwatchNameStyle}" Text="Text on Accent / Secondary" />
                                            <TextBlock Style="{StaticResource SwatchUsageStyle}" Text="Pressed only" />
                                            <TextBlock Style="{StaticResource SwatchKeyStyle}" Text="TextOnAccentFillColorSecondaryBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="0,2,2,0"
                                        Background="{DynamicResource TextOnAccentFillColorDisabledBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SwatchNameStyle}" Text="Text on Accent / Disabled" />
                                            <TextBlock Style="{StaticResource SwatchUsageStyle}" Text="Disabled only" />
                                            <TextBlock Style="{StaticResource SwatchKeyStyle}" Text="TextOnAccentFillColorDisabledBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="2,2,0,0"
                                        Background="{DynamicResource TextOnAccentFillColorSelectedTextBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SwatchNameStyle}" Text="Text on Accent / Selected Text" />
                                            <TextBlock Style="{StaticResource SwatchUsageStyle}" Text="Highlighted text" />
                                            <TextBlock Style="{StaticResource SwatchKeyStyle}" Text="TextOnAccentFillColorSelectedTextBrush" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!--  ═══ FILL TAB ═══  -->
                <TabItem Header="Fill" Style="{DynamicResource TabItemStyle}">
                    <StackPanel Margin="16">
                        <TextBlock Style="{StaticResource SwatchSectionHeaderStyle}" Text="Control Fill" />
                        <TextBlock Style="{StaticResource SwatchSectionDescStyle}" Text="Fill used for standard controls" />
                        <Border
                            Margin="0,0,0,24"
                            Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <StackPanel>
                                <UniformGrid Columns="4" Rows="2">
                                    <Border
                                        Margin="0,0,2,2"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchNameStyle}"
                                                Text="Control / Default" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchUsageStyle}"
                                                Text="Rest" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchKeyStyle}"
                                                Text="ControlFillColorDefaultBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="2,0,2,2"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchNameStyle}"
                                                Text="Control / Secondary" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchUsageStyle}"
                                                Text="Hover" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchKeyStyle}"
                                                Text="ControlFillColorSecondaryBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="2,0,2,2"
                                        Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchNameStyle}"
                                                Text="Control / Tertiary" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchUsageStyle}"
                                                Text="Pressed" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchKeyStyle}"
                                                Text="ControlFillColorTertiaryBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="2,0,0,2"
                                        Background="{DynamicResource ControlFillColorQuarternaryBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchNameStyle}"
                                                Text="Control / Quarternary" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchUsageStyle}"
                                                Text="Pill Button" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchKeyStyle}"
                                                Text="ControlFillColorQuarternaryBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="0,2,2,0"
                                        Background="{DynamicResource ControlFillColorDisabledBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchNameStyle}"
                                                Text="Control / Disabled" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchUsageStyle}"
                                                Text="Disabled" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchKeyStyle}"
                                                Text="ControlFillColorDisabledBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="2,2,2,0"
                                        Background="{DynamicResource ControlFillColorTransparentBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchNameStyle}"
                                                Text="Control / Transparent" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchUsageStyle}"
                                                Text="Rest" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchKeyStyle}"
                                                Text="ControlFillColorTransparentBrush" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="2,2,0,0"
                                        Background="{DynamicResource ControlFillColorInputActiveBrush}"
                                        Style="{StaticResource ColorSwatchCellStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchNameStyle}"
                                                Text="Control / Input Active" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchUsageStyle}"
                                                Text="Active text fields" />
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource SwatchKeyStyle}"
                                                Text="ControlFillColorInputActiveBrush" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SwatchSectionHeaderStyle}" Text="Control Alt Fill" />
                        <TextBlock Style="{StaticResource SwatchSectionDescStyle}" Text="Fill used for the off states of toggle controls" />
                        <Border
                            Margin="0,0,0,24"
                            Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <UniformGrid Columns="4">
                                <Border
                                    Margin="0,0,2,0"
                                    Background="{DynamicResource ControlAltFillColorTransparentBrush}"
                                    Style="{StaticResource ColorSwatchCellStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchNameStyle}"
                                            Text="Control Alt / Transparent" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchKeyStyle}"
                                            Text="ControlAltFillColorTransparentBrush" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="2,0,2,0"
                                    Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                    Style="{StaticResource ColorSwatchCellStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchNameStyle}"
                                            Text="Control Alt / Secondary" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchUsageStyle}"
                                            Text="Rest" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchKeyStyle}"
                                            Text="ControlAltFillColorSecondaryBrush" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="2,0,2,0"
                                    Background="{DynamicResource ControlAltFillColorTertiaryBrush}"
                                    Style="{StaticResource ColorSwatchCellStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchNameStyle}"
                                            Text="Control Alt / Tertiary" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchUsageStyle}"
                                            Text="Hover" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchKeyStyle}"
                                            Text="ControlAltFillColorTertiaryBrush" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="2,0,0,0"
                                    Background="{DynamicResource ControlAltFillColorDisabledBrush}"
                                    Style="{StaticResource ColorSwatchCellStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchNameStyle}"
                                            Text="Control Alt / Disabled" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchUsageStyle}"
                                            Text="Disabled" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchKeyStyle}"
                                            Text="ControlAltFillColorDisabledBrush" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>

                        <TextBlock Style="{StaticResource SwatchSectionHeaderStyle}" Text="Neutral Solid" />
                        <TextBlock Style="{StaticResource SwatchSectionDescStyle}" Text="Fills used for Slider thumb control to cover the track beneath it" />
                        <Border
                            Margin="0,0,0,16"
                            Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <UniformGrid Columns="2">
                                <Border
                                    Margin="0,0,2,0"
                                    Background="{DynamicResource ControlSolidFillColorDefaultBrush}"
                                    Style="{StaticResource ColorSwatchCellStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchNameStyle}"
                                            Text="Control Solid / Default" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchUsageStyle}"
                                            Text="Rest" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchKeyStyle}"
                                            Text="ControlSolidFillColorDefaultBrush" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="2,0,0,0"
                                    Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                    Style="{StaticResource ColorSwatchCellStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorInverseBrush}"
                                            Style="{StaticResource SwatchNameStyle}"
                                            Text="Control Strong / Default" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorInverseBrush}"
                                            Style="{StaticResource SwatchUsageStyle}"
                                            Text="Rest" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorInverseBrush}"
                                            Style="{StaticResource SwatchKeyStyle}"
                                            Text="ControlStrongFillColorDefaultBrush" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!--  ═══ STROKE TAB ═══  -->
                <TabItem Header="Stroke" Style="{DynamicResource TabItemStyle}">
                    <StackPanel Margin="16">
                        <TextBlock Style="{StaticResource SwatchSectionHeaderStyle}" Text="Card Stroke" />
                        <TextBlock Style="{StaticResource SwatchSectionDescStyle}" Text="Used for card and layer colors" />
                        <Border
                            Margin="0,0,0,24"
                            Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <UniformGrid Columns="2">
                                <Border
                                    Margin="0,0,2,0"
                                    Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Style="{StaticResource ColorSwatchCellStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SwatchNameStyle}" Text="Card Stroke / Default" />
                                        <TextBlock Style="{StaticResource SwatchKeyStyle}" Text="CardStrokeColorDefaultBrush" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="2,0,0,0"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                    Style="{StaticResource ColorSwatchCellStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SwatchNameStyle}" Text="Card Stroke / Default Solid" />
                                        <TextBlock Style="{StaticResource SwatchKeyStyle}" Text="CardStrokeColorDefaultSolidBrush" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>

                        <TextBlock Style="{StaticResource SwatchSectionHeaderStyle}" Text="Control Elevation (gradient strokes)" />
                        <TextBlock Style="{StaticResource SwatchSectionDescStyle}" Text="Used for standard control strokes and stroke states" />
                        <Border
                            Margin="0,0,0,24"
                            Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <UniformGrid Columns="3">
                                <Border
                                    Margin="0,0,2,0"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="2"
                                    Style="{StaticResource ColorSwatchCellStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchNameStyle}"
                                            Text="Control / Border" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchUsageStyle}"
                                            Text="Rest" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchKeyStyle}"
                                            Text="ControlElevationBorderBrush" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="2,0,2,0"
                                    BorderBrush="{DynamicResource TextControlElevationBorderBrush}"
                                    BorderThickness="2"
                                    Style="{StaticResource ColorSwatchCellStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchNameStyle}"
                                            Text="Text Control / Border" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchUsageStyle}"
                                            Text="Rest" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchKeyStyle}"
                                            Text="TextControlElevationBorderBrush" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="2,0,0,0"
                                    BorderBrush="{DynamicResource AccentControlElevationBorderBrush}"
                                    BorderThickness="2"
                                    Style="{StaticResource ColorSwatchCellStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchNameStyle}"
                                            Text="Accent Control / Border" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchUsageStyle}"
                                            Text="Rest" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource SwatchKeyStyle}"
                                            Text="AccentControlElevationBorderBrush" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>

                        <TextBlock Style="{StaticResource SwatchSectionHeaderStyle}" Text="Control Stroke" />
                        <TextBlock Style="{StaticResource SwatchSectionDescStyle}" Text="Used for gradient stops in elevation borders, and for control states" />
                        <Border
                            Margin="0,0,0,24"
                            Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <UniformGrid Columns="4">
                                <Border
                                    Margin="0,0,2,2"
                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Style="{StaticResource ColorSwatchCellStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SwatchNameStyle}" Text="Control Stroke / Default" />
                                        <TextBlock Style="{StaticResource SwatchKeyStyle}" Text="ControlStrokeColorDefaultBrush" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="2,0,2,2"
                                    Background="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                    Style="{StaticResource ColorSwatchCellStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SwatchNameStyle}" Text="Control Stroke / Secondary" />
                                        <TextBlock Style="{StaticResource SwatchKeyStyle}" Text="ControlStrokeColorSecondaryBrush" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="2,0,2,2"
                                    Background="{DynamicResource ControlStrokeColorOnAccentDefaultBrush}"
                                    Style="{StaticResource ColorSwatchCellStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SwatchNameStyle}" Text="On Accent Default" />
