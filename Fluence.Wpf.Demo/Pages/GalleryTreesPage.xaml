<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryTreesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" HorizontalAlignment="Stretch">

            <!--  ── Basic TreeView ──  -->
            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="TreeView — file system hierarchy" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Nested folders with expand/collapse animation. Click an item to see its path in the label below." />
            <ui:Card
                Margin="0,0,0,8"
                Padding="8"
                Variant="{x:Static uicore:CardVariant.Default}">
                <ui:TreeView
                    x:Name="FileTreeView"
                    MaxHeight="340"
                    SelectedItemChanged="FileTreeView_SelectedItemChanged">
                    <ui:TreeViewItem
                        x:Name="RootSrcItem"
                        Header="src"
                        IsExpanded="True">
                        <ui:TreeViewItem Header="Controls" IsExpanded="True">
                            <ui:TreeViewItem Header="Button.cs" />
                            <ui:TreeViewItem Header="Card.cs" />
                            <ui:TreeViewItem Header="ComboBox.cs" />
                            <ui:TreeViewItem Header="NavigationView.cs" />
                            <ui:TreeViewItem Header="ProgressRing.cs" />
                            <ui:TreeViewItem Header="TreeView.cs" />
                        </ui:TreeViewItem>
                        <ui:TreeViewItem Header="Themes">
                            <ui:TreeViewItem Header="Colors">
                                <ui:TreeViewItem Header="Theme.Light.xaml" />
                                <ui:TreeViewItem Header="Theme.Dark.xaml" />
                                <ui:TreeViewItem Header="Theme.HighContrast.xaml" />
                            </ui:TreeViewItem>
                            <ui:TreeViewItem Header="Controls">
                                <ui:TreeViewItem Header="Button.xaml" />
                                <ui:TreeViewItem Header="Card.xaml" />
                                <ui:TreeViewItem Header="TreeView.xaml" />
                            </ui:TreeViewItem>
                            <ui:TreeViewItem Header="Generic.xaml" />
                        </ui:TreeViewItem>
                        <ui:TreeViewItem Header="Helpers">
                            <ui:TreeViewItem Header="GridLengthAnimation.cs" />
                            <ui:TreeViewItem Header="OsVersionHelper.cs" />
                        </ui:TreeViewItem>
                    </ui:TreeViewItem>
                    <ui:TreeViewItem Header="docs">
                        <ui:TreeViewItem Header="controls.md" />
                        <ui:TreeViewItem Header="theming.md" />
                        <ui:TreeViewItem Header="getting-started.md" />
                        <ui:TreeViewItem Header="_internal">
                            <ui:TreeViewItem Header="uplift-plan.md" />
                            <ui:TreeViewItem Header="winui-tranche-3-backlog.md" />
                        </ui:TreeViewItem>
                    </ui:TreeViewItem>
                    <ui:TreeViewItem Header="Fluence.Wpf.Tests">
                        <ui:TreeViewItem Header="ControlTests.Card.cs" />
                        <ui:TreeViewItem Header="ControlTests.TreeView.cs" />
                        <ui:TreeViewItem Header="WpfTestSta.cs" />
                    </ui:TreeViewItem>
                    <ui:TreeViewItem Header="Fluence.Wpf.Demo">
                        <ui:TreeViewItem Header="Pages">
                            <ui:TreeViewItem Header="GalleryHomePage.xaml" />
                            <ui:TreeViewItem Header="GalleryTreesPage.xaml" />
                            <ui:TreeViewItem Header="GalleryMenusPage.xaml" />
                        </ui:TreeViewItem>
                        <ui:TreeViewItem Header="MainWindow.xaml" />
                    </ui:TreeViewItem>
                    <ui:TreeViewItem Header="CHANGELOG.md" />
                    <ui:TreeViewItem Header="CLAUDE.md" />
                </ui:TreeView>
            </ui:Card>
            <TextBlock
                x:Name="TreeSelectionLabel"
                Margin="0,0,0,24"
                ui:TextBlockExtensions.Typography="Caption"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Selected: —" />

            <!--  ── TreeView keyboard navigation info ──  -->
            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="Keyboard navigation" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="The TreeView above fully supports keyboard navigation. Use the shortcuts below." />
            <ui:Card
                Margin="0,0,0,24"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        ui:TextBlockExtensions.Typography="BodyStrong"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Text="↑ / ↓" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        ui:TextBlockExtensions.Typography="Body"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Move selection up / down" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        ui:TextBlockExtensions.Typography="BodyStrong"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Text="→" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        ui:TextBlockExtensions.Typography="Body"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Expand selected node (or move into first child if already expanded)" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        ui:TextBlockExtensions.Typography="BodyStrong"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Text="←" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="2"
                        ui:TextBlockExtensions.Typography="Body"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Collapse selected node (or move to parent if already collapsed)" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        ui:TextBlockExtensions.Typography="BodyStrong"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Text="Space / Enter" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="2"
                        ui:TextBlockExtensions.Typography="Body"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Toggle expand / collapse for the focused node" />

                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        ui:TextBlockExtensions.Typography="BodyStrong"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Text="Home / End" />
                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="2"
                        ui:TextBlockExtensions.Typography="Body"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Jump to first / last visible item" />
                </Grid>
            </ui:Card>

            <!--  ── Programmatic expand / collapse ──  -->
            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="Programmatic control" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Expand or collapse the entire tree from code." />
            <ui:Card
                Margin="0,0,0,24"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Click="ExpandAll_Click"
                        Content="Expand all" />
                    <ui:Button Click="CollapseAll_Click" Content="Collapse all" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
