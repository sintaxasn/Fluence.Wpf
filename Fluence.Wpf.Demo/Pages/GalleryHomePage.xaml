<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    d:DesignHeight="800"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,32" HorizontalAlignment="Stretch">
            <!--  Hero: diamond logo mark + brand text + stats row  -->
            <StackPanel Margin="0,8,0,28" HorizontalAlignment="Center">
                <ui:StackPanel Spacing ="20" VerticalAlignment="Center" Orientation="Horizontal">
                    <Image
                    Width="88"
                    Height="88"
                    HorizontalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    SnapsToDevicePixels="True"
                    Source="pack://application:,,,/Fluence.Wpf.Demo;component/Resources/AppIcon.png"
                    Stretch="Uniform" />
                    <TextBlock
                    HorizontalAlignment="Center"
                    ui:TextBlockExtensions.Typography="Display"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="Fluence"
                    TextOptions.TextFormattingMode="Ideal" />
                    <TextBlock
                    HorizontalAlignment="Center"
                    ui:TextBlockExtensions.Typography="Display"
                    Foreground="#81cfff"
                    Text=".Wpf"
                    TextOptions.TextFormattingMode="Ideal" />
                </ui:StackPanel>
                <TextBlock
                    
                    HorizontalAlignment="Center"
                    ui:TextBlockExtensions.Typography="Subtitle"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Windows 11 Fluent Design controls for WPF" />
        </StackPanel>

            <!--  Action cards  -->
            <UniformGrid Margin="0,8,0,16" Columns="2">
                <ui:Card
                    Margin="0,0,10,10"
                    Padding="20"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="window"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE790;"
                                IconFontSize="24" />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="Subtitle"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Theming" />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Body"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Light, Dark, High Contrast, and Auto — follows the OS accent. Brushes map to WinUI 3 themeresource key names."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="10,0,0,10"
                    Padding="20"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="window"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE737;"
                                IconFontSize="24" />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="Subtitle"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Shell" />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Body"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Mica, Acrylic, and Tabbed DWM backdrops. Rounded corners, caption extension, and icon + title bar controls on FluenceWindow."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="0,0,10,0"
                    Padding="20"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="buttons"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE8E5;"
                                IconFontSize="24" />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="Subtitle"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Controls" />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Body"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="40+ controls — inputs, menus, tooltips, trees, navigation, feedback, data views, and tabs — all DynamicResource-driven."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="10,0,0,0"
                    Padding="20"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="colors"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE2B1;"
                                IconFontSize="24" />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="Subtitle"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Fidelity" />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Body"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Canonical WinUI 3 easing (0.8,0,0,1 KeySpline), 83–167 ms durations, and WinUI themeresource key naming throughout."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!--  Featured controls  -->
            <TextBlock
                Margin="0,8,0,12"
                ui:TextBlockExtensions.Typography="Subtitle"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Featured controls" />

            <UniformGrid x:Name="FeaturedControlsGrid" Columns="3">
                <ui:Card
                    Margin="0,0,6,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="buttons"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE8E5;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Buttons" />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Primary, secondary, accent, hyperlink."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,6,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="selection"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE73E;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Selection" />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Checkbox, radio, toggle switch."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,0,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="inputs"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE70F;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Inputs" />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Text, password, combo, slider, number."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="0,0,6,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="status"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE916;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Status" />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="InfoBar, progress ring, progress bar."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,6,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="data"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE80A;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Collections" />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="List views, cards, layout panels."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,0,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="navigation"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE700;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Navigation" />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Pane layouts, selection, header."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="0,0,6,0"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="tabs"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE748;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Tabs" />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="TabView, tab strip, close buttons."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,6,0"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="buttons"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE712;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Menus" />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="ContextMenu, MenuItem, flyout."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,0,0"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="data"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE71C;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Trees" />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="TreeView, expand, indent, chevron."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>
        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
