<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    d:DesignHeight="800"
    d:DesignWidth="900"
    mc:Ignorable="d"
    >
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,32" HorizontalAlignment="Stretch">
            <!--  Hero banner with title/subtitle overlaid on the left  -->
            <Grid>
                <Grid Margin="24,0,24,0">
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image
                            x:Name="BannerImage"
                            Height="100"
                            Margin="0,0,0,24"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Source="pack://application:,,,/Fluence.Wpf.Demo;component/Resources/BannerLight.png"
                            StretchDirection="DownOnly"
                            />

                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ui:TextBlockExtensions.Typography="Title"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="WinUI / Fluent Design for WPF"
                            />
                        <TextBlock
                            Margin="0,8,0,8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ui:TextBlockExtensions.Typography="Body"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            >
                            <Run Text="· " /><Run Text="A near-complete replica of WinUI 3 but without being forced to use the Windows App SDK. " /><LineBreak />
                            <Run Text="·" /><Run Text=" Targets .NET Framework 4.7.2 and supporting Windwos 10 (1809+) and above." /><LineBreak />
                            <Run Text="·" /><Run Text=" Licensed under 3-Clause BSD" /><LineBreak />
                            <Run /><LineBreak />
                            <Run Text="Browse categories in the pane, search from the title bar, or pick a topic below to get started." /></TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>

            <!--  Action cards  -->
            <UniformGrid Margin="0,8,0,16" Columns="2">
                <ui:Card
                    Margin="0,0,10,10"
                    Padding="20"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="window"
                    Variant="{x:Static uicore:CardVariant.Default}"
                    >
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE790;"
                                IconFontSize="24"
                                />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="Subtitle"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Theming"
                                />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Body"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Light, Dark, High Contrast, and Auto track Windows. Accent ramps follow WinUI resource keys."
                            TextWrapping="Wrap"
                            />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="10,0,0,10"
                    Padding="20"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="window"
                    Variant="{x:Static uicore:CardVariant.Default}"
                    >
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE737;"
                                IconFontSize="24"
                                />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="Subtitle"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Shell"
                                />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Body"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Mica, Acrylic, and Tabbed backdrops with rounded corners on FluenceWindow."
                            TextWrapping="Wrap"
                            />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="0,0,10,0"
                    Padding="20"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="buttons"
                    Variant="{x:Static uicore:CardVariant.Default}"
                    >
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE8E5;"
                                IconFontSize="24"
                                />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="Subtitle"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Controls"
                                />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Body"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Inputs, navigation, feedback, data views, and typography — all DynamicResource-driven."
                            TextWrapping="Wrap"
                            />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="10,0,0,0"
                    Padding="20"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="colors"
                    Variant="{x:Static uicore:CardVariant.Default}"
                    >
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE2B1;"
                                IconFontSize="24"
                                />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="Subtitle"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Fidelity"
                                />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Body"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Templates and brushes follow WinUI 3 themeresources naming and interaction timings."
                            TextWrapping="Wrap"
                            />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!--  Featured controls  -->
            <TextBlock
                Margin="0,8,0,12"
                ui:TextBlockExtensions.Typography="Subtitle"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Featured controls"
                />

            <UniformGrid x:Name="FeaturedControlsGrid" Columns="3">
                <ui:Card
                    Margin="0,0,6,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="buttons"
                    Variant="{x:Static uicore:CardVariant.Default}"
                    >
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE8E5;"
                                IconFontSize="20"
                                />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Buttons"
                                />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Primary, secondary, accent, hyperlink."
                            TextWrapping="Wrap"
                            />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,6,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="selection"
                    Variant="{x:Static uicore:CardVariant.Default}"
                    >
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE73E;"
                                IconFontSize="20"
                                />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Selection"
                                />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Checkbox, radio, toggle switch."
                            TextWrapping="Wrap"
                            />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,0,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="inputs"
                    Variant="{x:Static uicore:CardVariant.Default}"
                    >
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE70F;"
                                IconFontSize="20"
                                />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Inputs"
                                />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Text, password, combo, slider, number."
                            TextWrapping="Wrap"
                            />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="0,0,6,0"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="status"
                    Variant="{x:Static uicore:CardVariant.Default}"
                    >
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE916;"
                                IconFontSize="20"
                                />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Status"
                                />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="InfoBar, progress ring, progress bar."
                            TextWrapping="Wrap"
                            />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,6,0"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="data"
                    Variant="{x:Static uicore:CardVariant.Default}"
                    >
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE80A;"
                                IconFontSize="20"
                                />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Collections"
                                />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="List views, cards, layout panels."
                            TextWrapping="Wrap"
                            />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,0,0"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="navigation"
                    Variant="{x:Static uicore:CardVariant.Default}"
                    >
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE700;"
                                IconFontSize="20"
                                />
                            <TextBlock
                                VerticalAlignment="Center"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Navigation"
                                />
                        </StackPanel>
                        <TextBlock
                            ui:TextBlockExtensions.Typography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Pane layouts, selection, header."
                            TextWrapping="Wrap"
                            />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>
        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
