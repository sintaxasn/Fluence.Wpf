<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    d:DesignHeight="800"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer Style="{StaticResource GalleryPageScrollViewerStyle}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Style="{StaticResource GalleryPageContentStackStyle}">
            <!--  Hero brand graphic  -->
            <StackPanel Margin="0,8,0,28" HorizontalAlignment="Center">
                <Image
                    x:Name="BrandBannerImage"
                    Height="224"
                    MaxWidth="760"
                    HorizontalAlignment="Stretch"
                    RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock
                    Margin="0,0,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Windows 11 Fluent Design controls for WPF" />
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                    <Hyperlink NavigateUri="https://github.com/sintaxasn/fluence.wpf" RequestNavigate="GitHubLink_RequestNavigate">
                        <Run Text="https://github.com/sintaxasn/fluence.wpf" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <!--  Action cards  -->
            <UniformGrid Margin="0,8,0,16" Columns="2">
                <ui:Card
                    Margin="0,0,10,10"
                    Padding="20"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="settings"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE790;"
                                IconFontSize="24" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Theming" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Light, Dark, High Contrast, and Auto - follows the OS accent. Brushes map to WinUI 3 themeresource key names."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="10,0,0,10"
                    Padding="20"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="settings"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE737;"
                                IconFontSize="24" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Shell" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Mica, Acrylic, and Tabbed DWM backdrops. Rounded corners, caption extension, and icon + title bar controls on FluenceWindow."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

            </UniformGrid>

            <!--  Featured controls  -->
            <TextBlock
                Margin="0,8,0,12"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Featured controls" />

            <UniformGrid x:Name="FeaturedControlsGrid" Columns="3">
                <ui:Card
                    Margin="0,0,6,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="buttons"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE8E5;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Buttons" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Primary, secondary, accent, hyperlink."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,6,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="selection"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE73E;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Selection" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Checkbox, radio, toggle switch."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,0,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="inputs"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE70F;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Inputs" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Text, password, combo, slider, number."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="0,0,6,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="status"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE916;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Status" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="InfoBar, progress ring, progress bar."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,6,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="data"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE80A;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Collections" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="List views, cards, layout panels."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,0,12"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="navigation"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE700;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Navigation" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Pane layouts, selection, header."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="0,0,6,0"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="tabs"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE748;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Tabs" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="TabView, tab strip, close buttons."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,6,0"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="buttons"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE712;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Menus" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="ContextMenu, MenuItem, flyout."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Margin="6,0,0,0"
                    Padding="16"
                    Click="Card_Click"
                    IsClickable="True"
                    Tag="data"
                    Variant="{x:Static uicore:CardVariant.Default}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:FontIcon
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE71C;"
                                IconFontSize="20" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Trees" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="TreeView, expand, indent, chevron."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>
        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
