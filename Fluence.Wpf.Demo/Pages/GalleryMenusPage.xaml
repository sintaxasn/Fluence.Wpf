<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryMenusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" HorizontalAlignment="Stretch">

            <!--  ── ContextMenu ──  -->
            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="ContextMenu" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Right-click the card below to open the ContextMenu. Demonstrates checkable items, separators, submenus, and disabled state." />
            <ui:Card
                Margin="0,0,0,24"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <ui:Card.ContextMenu>
                    <ui:ContextMenu>
                        <ui:MenuItem
                            Click="CutMenuItem_Click"
                            Header="Cut"
                            InputGestureText="Ctrl+X">
                            <ui:MenuItem.Icon>
                                <ui:FontIcon Glyph="&#xE8C6;" IconFontSize="16" />
                            </ui:MenuItem.Icon>
                        </ui:MenuItem>
                        <ui:MenuItem
                            Click="CopyMenuItem_Click"
                            Header="Copy"
                            InputGestureText="Ctrl+C">
                            <ui:MenuItem.Icon>
                                <ui:FontIcon Glyph="&#xE8C8;" IconFontSize="16" />
                            </ui:MenuItem.Icon>
                        </ui:MenuItem>
                        <ui:MenuItem
                            Click="PasteMenuItem_Click"
                            Header="Paste"
                            InputGestureText="Ctrl+V">
                            <ui:MenuItem.Icon>
                                <ui:FontIcon Glyph="&#xE77F;" IconFontSize="16" />
                            </ui:MenuItem.Icon>
                        </ui:MenuItem>
                        <Separator />
                        <ui:MenuItem
                            x:Name="FavouriteMenuItem"
                            Header="Add to favourites"
                            IsCheckable="True" />
                        <Separator />
                        <ui:MenuItem Header="Share">
                            <ui:MenuItem.Icon>
                                <ui:FontIcon Glyph="&#xE72D;" IconFontSize="16" />
                            </ui:MenuItem.Icon>
                            <ui:MenuItem Click="ShareCopyLink_Click" Header="Copy link" />
                            <ui:MenuItem Click="ShareEmail_Click" Header="Send via email" />
                            <ui:MenuItem Header="Export to PDF" IsEnabled="False" />
                        </ui:MenuItem>
                        <Separator />
                        <ui:MenuItem Header="Delete" IsEnabled="False">
                            <ui:MenuItem.Icon>
                                <ui:FontIcon Glyph="&#xE74D;" IconFontSize="16" />
                            </ui:MenuItem.Icon>
                        </ui:MenuItem>
                    </ui:ContextMenu>
                </ui:Card.ContextMenu>
                <StackPanel>
                    <TextBlock
                        ui:TextBlockExtensions.Typography="Body"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Right-click here to open the context menu" />
                    <TextBlock
                        x:Name="ContextMenuResultLabel"
                        Margin="0,8,0,0"
                        ui:TextBlockExtensions.Typography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Last action: —" />
                </StackPanel>
            </ui:Card>

            <!--  ── ToolTip ──  -->
            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="ToolTip" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Hover any button below to see the Fluent ToolTip with rounded corners and shadow." />
            <ui:Card
                Margin="0,0,0,24"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <WrapPanel>
                    <ui:Button Margin="0,0,8,8" Content="Save">
                        <ui:Button.ToolTip>
                            <ui:ToolTip Content="Save changes (Ctrl+S)" />
                        </ui:Button.ToolTip>
                    </ui:Button>
                    <ui:Button Margin="0,0,8,8" Content="Delete">
                        <ui:Button.ToolTip>
                            <ui:ToolTip Content="Permanently delete the selected item" />
                        </ui:Button.ToolTip>
                    </ui:Button>
                    <ui:Button Margin="0,0,8,8" Content="Share">
                        <ui:Button.ToolTip>
                            <ui:ToolTip>
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="Share" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Copy a link or send via email" />
                                </StackPanel>
                            </ui:ToolTip>
                        </ui:Button.ToolTip>
                    </ui:Button>
                    <ui:Button
                        Margin="0,0,8,8"
                        Content="Settings"
                        IsEnabled="False">
                        <ui:Button.ToolTip>
                            <ui:ToolTip Content="Settings (disabled in this context)" />
                        </ui:Button.ToolTip>
                    </ui:Button>
                </WrapPanel>
            </ui:Card>

            <!--  ── DropDownButton with submenu ──  -->
            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="DropDownButton menu" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="DropDownButton opens a ContextMenu flyout with nested items and keyboard arrow navigation." />
            <ui:Card
                Margin="0,0,0,24"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel Orientation="Horizontal">
                    <ui:DropDownButton
                        x:Name="SortDropDown"
                        Margin="0,0,8,0"
                        Content="Sort by">
                        <ui:DropDownButton.Flyout>
                            <StackPanel MinWidth="160" Margin="4">
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Appearance="Subtle"
                                    Click="Sort_Click"
                                    Content="Name (A → Z)"
                                    Tag="name-asc" />
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Appearance="Subtle"
                                    Click="Sort_Click"
                                    Content="Name (Z → A)"
                                    Tag="name-desc" />
                                <Rectangle
                                    Height="1"
                                    Margin="4,2"
                                    Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Appearance="Subtle"
                                    Click="Sort_Click"
                                    Content="Date modified (newest)"
                                    Tag="date-desc" />
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Appearance="Subtle"
                                    Click="Sort_Click"
                                    Content="Date modified (oldest)"
                                    Tag="date-asc" />
                                <Rectangle
                                    Height="1"
                                    Margin="4,2"
                                    Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Appearance="Subtle"
                                    Click="Sort_Click"
                                    Content="Size (largest)"
                                    Tag="size-desc" />
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Appearance="Subtle"
                                    Click="Sort_Click"
                                    Content="Size (smallest)"
                                    Tag="size-asc" />
                            </StackPanel>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                    <ui:SplitButton
                        x:Name="ExportSplitButton"
                        Click="ExportPrimary_Click"
                        Content="Export">
                        <ui:SplitButton.Flyout>
                            <StackPanel MinWidth="160" Margin="4">
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Appearance="Subtle"
                                    Click="ExportFormat_Click"
                                    Content="Export as CSV"
                                    Tag="csv" />
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Appearance="Subtle"
                                    Click="ExportFormat_Click"
                                    Content="Export as JSON"
                                    Tag="json" />
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Appearance="Subtle"
                                    Click="ExportFormat_Click"
                                    Content="Export as XML"
                                    Tag="xml" />
                                <Rectangle
                                    Height="1"
                                    Margin="4,2"
                                    Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Appearance="Subtle"
                                    Click="ExportFormat_Click"
                                    Content="Export settings…"
                                    Tag="settings" />
                            </StackPanel>
                        </ui:SplitButton.Flyout>
                    </ui:SplitButton>
                    <TextBlock
                        x:Name="MenuActionLabel"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        ui:TextBlockExtensions.Typography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Last action: —" />
                </StackPanel>
            </ui:Card>

            <!--  ── Menu bar ──  -->
            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="Menu bar" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Fluent Menu with File / Edit / View / Help — nested submenus, checkable items, and keyboard mnemonics." />
            <ui:Card
                Margin="0,0,0,24"
                Padding="8"
                Variant="{x:Static uicore:CardVariant.Default}">
                <ui:Menu>
                    <ui:MenuItem Header="_File">
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="_New"
                            InputGestureText="Ctrl+N"
                            Tag="File → New" />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="_Open…"
                            InputGestureText="Ctrl+O"
                            Tag="File → Open" />
                        <ui:MenuItem Header="Open _Recent">
                            <ui:MenuItem
                                Click="MenuBar_Click"
                                Header="Document1.txt"
                                Tag="File → Recent → Document1.txt" />
                            <ui:MenuItem
                                Click="MenuBar_Click"
                                Header="Report_Q1.xlsx"
                                Tag="File → Recent → Report_Q1.xlsx" />
                            <ui:MenuItem
                                Click="MenuBar_Click"
                                Header="Notes.md"
                                Tag="File → Recent → Notes.md" />
                        </ui:MenuItem>
                        <Separator />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="_Save"
                            InputGestureText="Ctrl+S"
                            Tag="File → Save" />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="Save _As…"
                            InputGestureText="Ctrl+Shift+S"
                            Tag="File → Save As" />
                        <Separator />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="_Print…"
                            InputGestureText="Ctrl+P"
                            Tag="File → Print" />
                        <Separator />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="E_xit"
                            Tag="File → Exit" />
                    </ui:MenuItem>
                    <ui:MenuItem Header="_Edit">
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="Undo"
                            InputGestureText="Ctrl+Z"
                            Tag="Edit → Undo" />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="Redo"
                            InputGestureText="Ctrl+Y"
                            Tag="Edit → Redo" />
                        <Separator />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="Cut"
                            InputGestureText="Ctrl+X"
                            Tag="Edit → Cut" />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="Copy"
                            InputGestureText="Ctrl+C"
                            Tag="Edit → Copy" />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="Paste"
                            InputGestureText="Ctrl+V"
                            Tag="Edit → Paste" />
                        <Separator />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="Select All"
                            InputGestureText="Ctrl+A"
                            Tag="Edit → Select All" />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="Find…"
                            InputGestureText="Ctrl+F"
                            Tag="Edit → Find" />
                    </ui:MenuItem>
                    <ui:MenuItem Header="_View">
                        <ui:MenuItem
                            x:Name="StatusBarMenuItem"
                            Click="MenuBar_Click"
                            Header="Status Bar"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="View → Status Bar" />
                        <ui:MenuItem
                            x:Name="WordWrapMenuItem"
                            Click="MenuBar_Click"
                            Header="Word Wrap"
                            IsCheckable="True"
                            Tag="View → Word Wrap" />
                        <Separator />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="Zoom _In"
                            InputGestureText="Ctrl++"
                            Tag="View → Zoom In" />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="Zoom _Out"
                            InputGestureText="Ctrl+-"
                            Tag="View → Zoom Out" />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="Reset Zoom"
                            InputGestureText="Ctrl+0"
                            Tag="View → Reset Zoom" />
                    </ui:MenuItem>
                    <ui:MenuItem Header="_Help">
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="Documentation"
                            Tag="Help → Docs" />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="Report a bug…"
                            Tag="Help → Bug" />
                        <Separator />
                        <ui:MenuItem
                            Click="MenuBar_Click"
                            Header="About"
                            IsEnabled="False"
                            Tag="Help → About" />
                    </ui:MenuItem>
                </ui:Menu>
            </ui:Card>
            <TextBlock
                x:Name="MenuBarResultLabel"
                Margin="0,0,0,24"
                ui:TextBlockExtensions.Typography="Caption"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Last menu action: —" />

        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
