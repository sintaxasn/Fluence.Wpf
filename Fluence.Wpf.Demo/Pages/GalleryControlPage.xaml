<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    d:DesignHeight="800"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PageStack" Margin="24">
            <TextBlock
                x:Name="ControlPageTitle"
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock
                x:Name="ControlPageDescription"
                Margin="0,0,0,24"
                Style="{StaticResource SectionDescriptionStyle}" />
        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
