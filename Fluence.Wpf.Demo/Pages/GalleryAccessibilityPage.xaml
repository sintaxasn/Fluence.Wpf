<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryAccessibilityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" HorizontalAlignment="Stretch">
            <TextBlock
                Margin="0,0,0,4"
                ui:TextBlockExtensions.Typography="Title"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Accessibility" />
            <TextBlock
                Margin="0,0,0,24"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="These examples show keyboard focus, tab order, high contrast brushes, automation names, and right-to-left layout in a simple code-behind demo." />

            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="Focus and tab order" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Press Tab to move keyboard focus. Fluence controls render the two-tone focus ring and follow visual tab order unless TabIndex overrides it." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <Grid x:Name="KeyboardSupportPrimaryControls" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,12,12"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="First focusable button"
                            Content="Button 1" />
                        <ui:Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,12,12"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Second focusable button"
                            Content="Button 2" />
                        <ui:TextBox
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,12,12"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Focusable text input"
                            PlaceholderText="TextBox" />
                        <ui:ComboBox
                            Grid.Row="0"
                            Grid.Column="3"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Focusable combo box">
                            <ComboBoxItem Content="Option A" IsSelected="True" />
                            <ComboBoxItem Content="Option B" />
                        </ui:ComboBox>
                        <ui:CheckBox
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Focusable checkbox"
                            Content="CheckBox" />
                        <ui:ToggleSwitch
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Focusable toggle" />
                        <ui:Slider
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,0,12,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Focusable slider"
                            Maximum="100"
                            Minimum="0"
                            Value="40" />
                        <ui:HyperlinkButton
                            Grid.Row="1"
                            Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Focusable hyperlink"
                            Content="HyperlinkButton" />
                    </Grid>

                    <TextBlock
                        Margin="0,12,0,8"
                        ui:TextBlockExtensions.Typography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="The buttons below have an explicit reverse tab order: 3, 2, 1." />
                    <Grid x:Name="KeyboardSupportExplicitOrderControls" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            HorizontalAlignment="Stretch"
                            Content="Tab order: 3"
                            TabIndex="3" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            HorizontalAlignment="Stretch"
                            Content="Tab order: 2"
                            TabIndex="2" />
                        <ui:Button
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Appearance="Accent"
                            Content="Tab order: 1 (first)"
                            TabIndex="1" />
                    </Grid>

                    <ui:HyperlinkButton
                        x:Name="FocusAndTabOrderSourceLink"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="High contrast brush mapping" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="In High Contrast mode, Fluence maps canonical WinUI keys to Windows system colors. Switch to High Contrast via the theme selector on the Window page to verify contrast live." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="0"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            Padding="12,8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    ui:TextBlockExtensions.Typography="BodyStrong"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="Fluence key" />
                                <TextBlock
                                    Grid.Column="1"
                                    ui:TextBlockExtensions.Typography="BodyStrong"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="HC system color" />
                                <TextBlock
                                    Grid.Column="2"
                                    ui:TextBlockExtensions.Typography="BodyStrong"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="Live swatch" />
                            </Grid>
                        </Border>
                        <ItemsControl x:Name="HcMappingTable" Grid.Row="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="12,6"
                                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                ui:TextBlockExtensions.Typography="Caption"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Key}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                ui:TextBlockExtensions.Typography="Caption"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding HcMapping}" />
                                            <Border
                                                Grid.Column="2"
                                                Width="32"
                                                Height="16"
                                                HorizontalAlignment="Left"
                                                Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <ui:HyperlinkButton
                        x:Name="HighContrastMappingSourceLink"
                        Margin="12,8,0,12"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="Automation properties" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Set AutomationProperties.Name for screen readers on controls that have no visible label." />
            <ui:Card
                Margin="0,0,0,16"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        ui:TextBlockExtensions.Typography="Body"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="These icon-only buttons all have AutomationProperties.Name so Narrator announces their purpose:"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Padding="8"
                            AutomationProperties.Name="New document">
                            <ui:FontIcon Glyph="&#xE8A5;" IconFontSize="18" />
                        </ui:Button>
                        <ui:Button
                            Margin="0,0,8,0"
                            Padding="8"
                            AutomationProperties.Name="Open file">
                            <ui:FontIcon Glyph="&#xE8E5;" IconFontSize="18" />
                        </ui:Button>
                        <ui:Button
                            Margin="0,0,8,0"
                            Padding="8"
                            AutomationProperties.Name="Save">
                            <ui:FontIcon Glyph="&#xE74E;" IconFontSize="18" />
                        </ui:Button>
                        <ui:Button
                            Margin="0,0,8,0"
                            Padding="8"
                            AutomationProperties.Name="Delete">
                            <ui:FontIcon Glyph="&#xE74D;" IconFontSize="18" />
                        </ui:Button>
                        <ui:Button Padding="8" AutomationProperties.Name="Share">
                            <ui:FontIcon Glyph="&#xE72D;" IconFontSize="18" />
                        </ui:Button>
                    </StackPanel>
                    <TextBlock
                        Margin="0,12,0,0"
                        ui:TextBlockExtensions.Typography="Caption"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="Tip: use Windows Narrator or Inspect.exe to verify automation names at runtime."
                        TextWrapping="Wrap" />
                    <ui:HyperlinkButton
                        x:Name="AutomationPropertiesSourceLink"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>

            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SectionHeaderStyle}"
                Text="Right-to-left (RTL) layout" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Toggle FlowDirection=RightToLeft on a card to verify Fluence controls mirror correctly for Arabic, Hebrew, and Farsi locales." />
            <ui:Card
                Margin="0,0,0,8"
                Padding="16"
                Variant="{x:Static uicore:CardVariant.Default}">
                <StackPanel>
                    <ui:ToggleSwitch
                        x:Name="RtlToggle"
                        Margin="0,0,0,12"
                        Checked="RtlToggle_Changed"
                        Content="Enable RTL on demo card"
                        Unchecked="RtlToggle_Changed" />
                    <ui:Card
                        x:Name="RtlDemoCard"
                        Padding="16"
                        Variant="{x:Static uicore:CardVariant.Outlined}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                ui:TextBlockExtensions.Typography="BodyStrong"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="نموذج عنصر تحكم" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Appearance="Accent"
                                    Content="زر رئيسي" />
                                <ui:Button Content="إلغاء" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                    <ui:HyperlinkButton
                        x:Name="RtlLayoutSourceLink"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DemoSourceLinkButtonStyle}"
                        Content="Source" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
