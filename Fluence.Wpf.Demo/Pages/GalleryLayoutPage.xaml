<UserControl
    x:Class="Fluence.Wpf.Demo.Pages.GalleryLayoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Fluence.Wpf.Demo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ui:SmoothScrollViewer Style="{StaticResource GalleryPageScrollViewerStyle}">
        <StackPanel Style="{StaticResource GalleryPageContentStackStyle}">
            <TextBlock
                Style="{StaticResource PageTitleStyle}"
                Text="Layout" />
            <TextBlock
                Style="{StaticResource SectionDescriptionStyle}"
                Text="Layout primitives arrange content, group related surfaces, and separate regions without adding page-specific infrastructure." />


            <ContentControl
                x:Name="DemoSampleSlot01DemoContentHost"
                Visibility="Collapsed">
<StackPanel>
                    <ui:Border
                        Padding="{DynamicResource DemoSampleInnerCardPadding}"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <ui:StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Settings group" />
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="StackPanel spacing keeps rows readable while Border frames the group."
                                TextWrapping="Wrap" />
                            <ui:Separator />
                            <DockPanel LastChildFill="True">
                                <ui:Button
                                    Appearance="Accent"
                                    Content="Apply"
                                    DockPanel.Dock="Right" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="DockPanel keeps the command aligned to the edge." />
                            </DockPanel>
                        </ui:StackPanel>
                    </ui:Border>

                    <ui:Expander x:Name="AdvancedOptionsExpander" Header="Advanced options">
                        <TextBlock
                            Margin="{DynamicResource DemoCompactStackSpacingMargin}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Expander shows secondary settings only when they are useful."
                            TextWrapping="Wrap" />
                    </ui:Expander>
                    </StackPanel>
            </ContentControl>
            <local:DemoSampleControl
                SampleDescription="StackPanel, Border, Separator, DockPanel, and Expander." />
        </StackPanel>
    </ui:SmoothScrollViewer>
</UserControl>
