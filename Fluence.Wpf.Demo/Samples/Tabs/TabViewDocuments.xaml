<UserControl
    x:Class="Fluence.Wpf.Demo.Samples.Tabs.TabViewDocuments"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf">
    <StackPanel>
        <ui:TabView
            x:Name="DemoTabView"
            Height="260"
            AddTabButtonClick="DemoTabView_AddTabButtonClick"
            CloseButtonOverlayMode="Auto"
            TabCloseRequested="DemoTabView_TabCloseRequested">
            <ui:TabViewItem
                Header="Document 1"
                IsSelected="True">
                <ui:TabViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE8A5;" IconFontSize="16" />
                </ui:TabViewItem.Icon>
                <StackPanel Margin="20">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Document 1" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Close document tabs or add another document from the tab row."
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:TabViewItem>
            <ui:TabViewItem Header="Document 2">
                <ui:TabViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE8A5;" IconFontSize="16" />
                </ui:TabViewItem.Icon>
                <StackPanel Margin="20">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Document 2" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Each tab hosts independent content."
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:TabViewItem>
            <ui:TabViewItem
                Header="Pinned"
                IsClosable="False">
                <ui:TabViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE718;" IconFontSize="16" />
                </ui:TabViewItem.Icon>
                <StackPanel Margin="20">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Pinned" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Set IsClosable to false when a tab should stay available."
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:TabViewItem>
        </ui:TabView>
        <TextBlock
            x:Name="DemoTabViewStatus"
            Margin="0,12,0,0"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="Tabs: 3" />
    </StackPanel>
</UserControl>
