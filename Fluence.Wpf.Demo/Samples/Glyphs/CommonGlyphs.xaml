<UserControl
    x:Class="Fluence.Wpf.Demo.Samples.Glyphs.CommonGlyphs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf">
    <WrapPanel>
        <StackPanel Margin="0,0,20,8">
            <ui:FontIcon
                HorizontalAlignment="Center"
                Glyph="&#xE80F;"
                IconFontSize="24" />
            <TextBlock
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Home" />
        </StackPanel>
        <StackPanel Margin="0,0,20,8">
            <ui:FontIcon
                HorizontalAlignment="Center"
                Glyph="&#xE8B7;"
                IconFontSize="24" />
            <TextBlock
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Folder" />
        </StackPanel>
        <StackPanel Margin="0,0,20,8">
            <ui:FontIcon
                HorizontalAlignment="Center"
                Glyph="&#xE77B;"
                IconFontSize="24" />
            <TextBlock
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Contact" />
        </StackPanel>
    </WrapPanel>
</UserControl>
