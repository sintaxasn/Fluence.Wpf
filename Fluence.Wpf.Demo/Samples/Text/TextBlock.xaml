<UserControl
    x:Class="Fluence.Wpf.Demo.Samples.Text.TextBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com">
    <fluence:StackPanel
        MaxWidth="560"
        HorizontalAlignment="Left"
        Spacing="10">
        <fluence:TextBlock
            Typography="Title"
            Text="Title text" />
        <fluence:TextBlock Text="Body text uses Fluent typography by default." />
        <fluence:TextBlock
            Typography="Caption"
            Text="Caption text" />
        <fluence:TextBlock
            Width="360"
            Text="Wrapped text keeps longer read-only content readable within the available width."
            TextWrapping="Wrap" />
        <fluence:TextBlock
            Width="260"
            Text="Trimmed text shows an ellipsis when the line cannot fit in the available width."
            TextTrimming="CharacterEllipsis" />
    </fluence:StackPanel>
</UserControl>
