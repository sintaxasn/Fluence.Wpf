<UserControl
    x:Class="Fluence.Wpf.Demo.Samples.Buttons.RepeatButtons"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf">
    <WrapPanel>
        <ui:RepeatButton Margin="0,0,8,8" Content="Hold to repeat" />
        <ui:RepeatButton
            Margin="0,0,8,8"
            Appearance="Accent"
            Content="Accent repeat" />
        <ui:RepeatButton
            Margin="0,0,8,8"
            Content="Disabled"
            IsEnabled="False" />
    </WrapPanel>
</UserControl>
