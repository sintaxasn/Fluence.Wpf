<UserControl
    x:Class="Fluence.Wpf.Demo.Samples.Data.ListBoxItems"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com">
    <WrapPanel>
        <fluence:ListBox
            Width="260"
            Margin="0,0,24,0"
            SelectedIndex="1">
            <ListBoxItem Content="Inbox" />
            <ListBoxItem Content="Pinned" />
            <ListBoxItem Content="Archive" />
        </fluence:ListBox>
        <fluence:ListBox Width="260" SelectionMode="Multiple">
            <ListBoxItem Content="Security review" IsSelected="True" />
            <ListBoxItem Content="Release notes" />
            <ListBoxItem Content="Accessibility pass" IsSelected="True" />
        </fluence:ListBox>
    </WrapPanel>
</UserControl>
