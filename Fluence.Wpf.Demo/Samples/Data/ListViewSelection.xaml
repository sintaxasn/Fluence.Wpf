<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf">
    <ui:StackPanel Spacing="14">
        <TextBlock
            Width="560"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="Single selects one item. Multiple shows check-style selection affordances. Extended supports Ctrl and Shift range selection."
            TextWrapping="Wrap" />
        <ui:ListView
            Width="400"
            Height="340"
            HorizontalAlignment="Left"
            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
            BorderThickness="1"
            SelectedIndex="0"
            SelectionMode="Extended">
            <ListViewItem>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="40"
                        Height="40"
                        Background="{DynamicResource AccentFillColorSecondaryBrush}"
                        CornerRadius="20">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            Text="AB" />
                    </Border>
                    <ui:StackPanel
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="Ana Bowman" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Support Engineer - Contoso" />
                    </ui:StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Available" />
                </Grid>
            </ListViewItem>
        </ui:ListView>
        <ui:StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="SelectionMode" />
            <ui:ComboBox Width="150" SelectedIndex="2">
                <ComboBoxItem Content="Single" />
                <ComboBoxItem Content="Multiple" />
                <ComboBoxItem Content="Extended" />
            </ui:ComboBox>
        </ui:StackPanel>
    </ui:StackPanel>
</UserControl>
