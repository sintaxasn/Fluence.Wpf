<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf">
    <ui:StackPanel Spacing="14">
        <TextBlock
            Width="560"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="This sample keeps the same ListView row style and inserts non-selectable group headers for a lightweight grouped list."
            TextWrapping="Wrap" />
        <ui:ListView
            Width="420"
            Height="360"
            HorizontalAlignment="Left"
            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
            BorderThickness="1"
            SelectedIndex="1">
            <ListViewItem Focusable="False" IsHitTestVisible="False">
                <TextBlock
                    Margin="0,10,0,4"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Contoso" />
            </ListViewItem>
            <ListViewItem>
                <ui:StackPanel Margin="0,4" Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="Ana Bowman" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Support Engineer - Available" />
                </ui:StackPanel>
            </ListViewItem>
            <ListViewItem>
                <ui:StackPanel Margin="0,4" Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="Shawn Hughes" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Platform Specialist - In a meeting" />
                </ui:StackPanel>
            </ListViewItem>
            <ListViewItem Focusable="False" IsHitTestVisible="False">
                <TextBlock
                    Margin="0,10,0,4"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Fabrikam" />
            </ListViewItem>
            <ListViewItem>
                <ui:StackPanel Margin="0,4" Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="Oscar Ward" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="DevOps Lead - Offline" />
                </ui:StackPanel>
            </ListViewItem>
        </ui:ListView>
    </ui:StackPanel>
</UserControl>
