<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf">
    <ui:ListView
        Width="460"
        Height="330"
        HorizontalAlignment="Left"
        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
        BorderThickness="1"
        SelectedIndex="0">
        <ListViewItem>
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="56"
                    Height="56"
                    Source="../../Resources/ControlImages/ListView.png"
                    Stretch="Uniform" />
                <ui:StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <TextBlock FontWeight="SemiBold" Text="ListView" />
                    <TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Single-column collection presentation."
                        TextWrapping="Wrap" />
                </ui:StackPanel>
            </Grid>
        </ListViewItem>
        <ListViewItem>
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="56"
                    Height="56"
                    Source="../../Resources/ControlImages/TreeView.png"
                    Stretch="Uniform" />
                <ui:StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <TextBlock FontWeight="SemiBold" Text="TreeView" />
                    <TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Hierarchical expandable collection."
                        TextWrapping="Wrap" />
                </ui:StackPanel>
            </Grid>
        </ListViewItem>
    </ui:ListView>
</UserControl>
