<UserControl
    x:Class="Fluence.Wpf.Demo.Samples.Layout.Border"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com">
    <WrapPanel>
        <fluence:Border
            MinWidth="120"
            MinHeight="56"
            Margin="0,0,16,16"
            Padding="14"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Rounded" />
        </fluence:Border>
        <fluence:Border
            MinWidth="120"
            MinHeight="56"
            Margin="0,0,16,16"
            Padding="14"
            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Subtle fill" />
        </fluence:Border>
    </WrapPanel>
</UserControl>
