<UserControl
    x:Class="Fluence.Wpf.Demo.Samples.Layout.StackPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com">
    <WrapPanel>
        <fluence:StackPanel Margin="0,0,24,0" Spacing="8">
            <Button Content="One" />
            <Button Content="Two" />
            <Button Content="Three" />
        </fluence:StackPanel>
        <fluence:StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="A" />
            <Button Content="B" />
            <Button Content="C" />
        </fluence:StackPanel>
    </WrapPanel>
</UserControl>
