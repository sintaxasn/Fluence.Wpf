<UserControl
    x:Class="Fluence.Wpf.Demo.Samples.Selection.RatingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf">
    <StackPanel>
        <ui:RatingControl
            Margin="0,0,0,12"
            Caption="Editable rating"
            Value="3" />
        <ui:RatingControl
            Margin="0,0,0,12"
            Caption="Read-only"
            IsReadOnly="True"
            Value="4" />
        <ui:RatingControl
            Margin="0,0,0,12"
            Caption="Ten point rating"
            MaxRating="10"
            Value="6" />
        <ui:RatingControl
            Caption="Disabled"
            IsEnabled="False"
            Value="2" />
    </StackPanel>
</UserControl>
