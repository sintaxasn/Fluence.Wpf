<UserControl
    x:Class="Fluence.Wpf.Demo.Samples.Status.InfoBadges"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com">
    <WrapPanel>
        <fluence:InfoBadge Width="18" Height="18" Margin="0,0,20,8" />
        <fluence:InfoBadge Width="24" Height="24" Margin="0,0,20,8" Value="7" />
        <fluence:InfoBadge
            Width="24"
            Height="24"
            Margin="0,0,20,8"
            BadgeStyle="Caution"
            Value="99" />
        <fluence:InfoBadge
            Width="24"
            Height="24"
            Margin="0,0,20,8"
            BadgeStyle="Critical">
            <fluence:InfoBadge.IconSource>
                <fluence:FontIcon Glyph="&#xE783;" IconFontSize="14" />
            </fluence:InfoBadge.IconSource>
        </fluence:InfoBadge>
    </WrapPanel>
</UserControl>
