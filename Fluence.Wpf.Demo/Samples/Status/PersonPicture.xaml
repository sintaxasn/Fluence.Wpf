<UserControl
    x:Class="Fluence.Wpf.Demo.Samples.Status.PersonPicture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluence="http://schemas.fluencewpf.com">
    <WrapPanel>
        <fluence:PersonPicture
            Width="48"
            Height="48"
            Margin="0,0,24,8"
            DisplayName="Alice Smith" />
        <fluence:PersonPicture
            Width="48"
            Height="48"
            Margin="0,0,24,8"
            Initials="MJ" />
        <fluence:PersonPicture
            Width="48"
            Height="48"
            Margin="0,0,24,8"
            DisplayName="Design Team"
            IsGroup="True" />
        <fluence:PersonPicture
            Width="48"
            Height="48"
            Margin="0,0,24,8"
            BadgeNumber="3"
            DisplayName="Jordan Lee" />
    </WrapPanel>
</UserControl>
