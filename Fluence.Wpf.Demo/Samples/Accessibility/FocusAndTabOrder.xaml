<UserControl
    x:Class="Fluence.Wpf.Demo.Samples.Accessibility.FocusAndTabOrder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf">
    <StackPanel>
        <WrapPanel>
            <ui:Button
                Margin="0,0,8,8"
                AutomationProperties.Name="First focusable button"
                Content="Button 1" />
            <ui:Button
                Margin="0,0,8,8"
                AutomationProperties.Name="Second focusable button"
                Content="Button 2" />
            <ui:CheckBox
                Margin="0,0,8,8"
                AutomationProperties.Name="Focusable checkbox"
                Content="CheckBox" />
            <ui:ToggleSwitch Margin="0,0,8,8" AutomationProperties.Name="Focusable toggle" />
            <ui:TextBox
                Width="160"
                Margin="0,0,8,8"
                AutomationProperties.Name="Focusable text input"
                PlaceholderText="TextBox" />
            <ui:ComboBox
                Width="140"
                Margin="0,0,8,8"
                AutomationProperties.Name="Focusable combo box">
                <ComboBoxItem Content="Option A" IsSelected="True" />
                <ComboBoxItem Content="Option B" />
            </ui:ComboBox>
            <ui:Slider
                Width="140"
                Margin="0,0,8,8"
                AutomationProperties.Name="Focusable slider"
                Maximum="100"
                Minimum="0"
                Value="40" />
            <ui:HyperlinkButton
                Margin="0,0,0,8"
                AutomationProperties.Name="Focusable hyperlink"
                Content="HyperlinkButton" />
        </WrapPanel>

        <TextBlock
            Margin="0,12,0,8"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="The buttons below have an explicit reverse tab order: 3, 2, 1." />
        <StackPanel Orientation="Horizontal">
            <ui:Button
                Margin="0,0,8,0"
                Content="Tab order: 3"
                TabIndex="3" />
            <ui:Button
                Margin="0,0,8,0"
                Content="Tab order: 2"
                TabIndex="2" />
            <ui:Button
                Appearance="Accent"
                Content="Tab order: 1 (first)"
                TabIndex="1" />
        </StackPanel>
    </StackPanel>
</UserControl>
