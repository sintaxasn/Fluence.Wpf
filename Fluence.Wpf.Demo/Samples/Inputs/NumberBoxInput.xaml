<UserControl
    x:Class="Fluence.Wpf.Demo.Samples.Inputs.NumberBoxInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf">
    <WrapPanel>
        <ui:NumberBox
            Width="260"
            Margin="0,0,16,12"
            Header="Inline"
            Maximum="100"
            Minimum="0"
            SpinButtonPlacementMode="Inline"
            Value="5" />
        <ui:NumberBox
            Width="260"
            Margin="0,0,16,12"
            Header="Compact"
            Maximum="100"
            Minimum="0"
            SpinButtonPlacementMode="Compact"
            Value="25" />
        <ui:NumberBox
            Width="260"
            Margin="0,0,16,12"
            Header="Keyboard only"
            Maximum="100"
            Minimum="0"
            SpinButtonPlacementMode="Hidden"
            Value="50" />
        <ui:NumberBox
            Width="260"
            Margin="0,0,16,12"
            Header="Disabled"
            IsEnabled="False"
            Value="42" />
    </WrapPanel>
</UserControl>
