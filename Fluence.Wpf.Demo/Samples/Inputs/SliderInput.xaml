<UserControl
    x:Class="Fluence.Wpf.Demo.Samples.Inputs.SliderInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf">
    <ui:StackPanel Spacing="18">
        <ui:StackPanel Spacing="8">
            <TextBlock Text="Volume" />
            <ui:Slider
                Maximum="100"
                Minimum="0"
                Value="35" />
        </ui:StackPanel>
        <ui:StackPanel Spacing="8">
            <TextBlock Text="Step frequency" />
            <ui:Slider
                IsSnapToTickEnabled="True"
                Maximum="10"
                Minimum="0"
                TickFrequency="1"
                Value="4" />
        </ui:StackPanel>
        <ui:StackPanel Spacing="24" Orientation="Horizontal">
            <ui:StackPanel Spacing="10">
                <TextBlock Text="Vertical" />
            <ui:Slider
                Height="150"
                Maximum="100"
                Minimum="0"
                Orientation="Vertical"
                Value="40" />
            </ui:StackPanel>
            <ui:StackPanel Spacing="10">
                <TextBlock Text="Disabled" />
            <ui:Slider
                Height="150"
                IsEnabled="False"
                Maximum="100"
                Minimum="0"
                Orientation="Vertical"
                Value="25" />
            </ui:StackPanel>
        </ui:StackPanel>
    </ui:StackPanel>
</UserControl>
