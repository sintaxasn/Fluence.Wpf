<UserControl
    x:Class="Fluence.Wpf.Demo.Samples.Forms.SignInForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf">
    <StackPanel MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Margin="0,0,0,4" Text="Email" />
        <ui:TextBox
            Margin="0,0,0,12"
            PlaceholderText="name@example.com" />
        <TextBlock Margin="0,0,0,4" Text="Password" />
        <ui:PasswordBox
            Margin="0,0,0,12"
            PlaceholderText="Password"
            RevealButtonEnabled="True" />
        <ui:CheckBox
            Margin="0,0,0,16"
            Content="Remember me" />
        <StackPanel Orientation="Horizontal">
            <ui:Button
                Margin="0,0,8,0"
                Appearance="Accent"
                Content="Sign in" />
            <ui:Button Content="Create account" />
        </StackPanel>
    </StackPanel>
</UserControl>
