<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net472;net10.0-windows10.0.26100.0</TargetFrameworks>
    <LangVersion Condition="'$(TargetFramework)' == 'net472'">7.3</LangVersion>
    <LangVersion Condition="$(TargetFramework.StartsWith('net10'))">latest</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Fluence.Wpf.Demo</RootNamespace>
    <AssemblyName>Fluence.Wpf.Demo</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluence.Wpf\Fluence.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.png" />
    <Resource Include="Resources\BannerDark.png" />
    <Resource Include="Resources\BannerLight.png" />
    <Resource Include="Resources\ControlImages\*.png" />
    <Resource Include="Resources\SegoeFluentIcons.tsv" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Samples\**\*.xaml" />
    <Compile Remove="Samples\**\*.xaml.cs" />
    <Content Include="Samples\**\*.xaml;Samples\**\*.xaml.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
