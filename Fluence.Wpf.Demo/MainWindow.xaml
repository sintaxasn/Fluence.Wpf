<ui:FluenceWindow
    x:Class="Fluence.Wpf.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    Title="Fluence.Wpf - Control Gallery"
    Width="1012"
    Height="918"
    MinWidth="698"
    MinHeight="520"
    CornerStyle="Round"
    ExtendsContentIntoTitleBar="False"
    Icon="Resources/fluence-wpf-appicon-256.ico"
    RenderOptions.BitmapScalingMode="HighQuality"
    SystemBackdropType="Mica"
    TitleBarHeight="42"
    UseLayoutRounding="True"
    >

    <ui:FluenceWindow.TitleBar>
        <ui:TitleBar
            x:Name="ShellTitleBar"
            Height="{Binding TitleBarHeight, RelativeSource={RelativeSource AncestorType=ui:FluenceWindow}}"
            BackRequested="ShellTitleBar_BackRequested"
            PaneToggleRequested="ShellTitleBar_PaneToggleRequested"
            SizeChanged="TitleBarLayout_SizeChanged"
            >
            <ui:TextBox
                x:Name="NavSearchBox"
                Width="520"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                LostKeyboardFocus="NavSearchBox_LostKeyboardFocus"
                PlaceholderText="Search"
                PreviewKeyDown="NavSearchBox_PreviewKeyDown"
                Style="{StaticResource TitleBarSearchBoxStyle}"
                TextChanged="NavSearchBox_TextChanged"
                WindowChrome.IsHitTestVisibleInChrome="True"
                />
        </ui:TitleBar>
    </ui:FluenceWindow.TitleBar>

    <ui:NavigationView
        x:Name="DemoNav"
        Background="Transparent"
        IsBackButtonVisible="True"
        IsBackEnabled="True"
        IsPaneOpen="True"
        IsPaneToggleButtonVisible="True"
        PaneDisplayMode="Top"
        SelectedIndex="0"
        >
        <ui:NavigationView.PaneFooter>
            <StackPanel
                x:Name="PaneModeToggleHost"
                Margin="0"
                Orientation="Horizontal"
                >
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType=ui:NavigationView}}" Value="{x:Static uicore:NavigationViewPaneDisplayMode.Left}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Bottom" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType=ui:NavigationView}}" Value="{x:Static uicore:NavigationViewPaneDisplayMode.LeftCompact}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Bottom" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock
                    x:Name="PaneModeToggleLabel"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Top"
                    ui:TextBlockExtensions.Typography="Body"
                    >
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType=ui:NavigationView}}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType=ui:NavigationView}}" Value="{x:Static uicore:NavigationViewPaneDisplayMode.LeftCompact}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ui:ToggleSwitch
                    x:Name="PaneModeToggle"
                    Width="40"
                    Checked="PaneModeToggle_CheckedChanged"
                    IsChecked="True"
                    Padding="0"
                    VerticalAlignment="Center"
                    Unchecked="PaneModeToggle_CheckedChanged"
                    />
            </StackPanel>
        </ui:NavigationView.PaneFooter>
    </ui:NavigationView>
</ui:FluenceWindow>
