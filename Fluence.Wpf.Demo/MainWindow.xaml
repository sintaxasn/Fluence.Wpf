<ui:FluenceWindow
    x:Class="Fluence.Wpf.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    Title="Fluence.Wpf — Control Gallery"
    Width="1100"
    Height="870"
    MinWidth="698"
    MinHeight="520"
    CornerStyle="Round"
    ExtendsContentIntoTitleBar="True"
    Icon="Resources/fluence-wpf-appicon-256.ico"
    RenderOptions.BitmapScalingMode="HighQuality"
    SystemBackdropType="Mica"
    TitleBarHeight="42"
    UseLayoutRounding="True"
    >

    <ui:FluenceWindow.TitleBar>
        <ui:TitleBar
            x:Name="ShellTitleBar"
            Height="{Binding TitleBarHeight, RelativeSource={RelativeSource AncestorType=ui:FluenceWindow}}"
            BackRequested="ShellTitleBar_BackRequested"
            PaneToggleRequested="ShellTitleBar_PaneToggleRequested"
            SizeChanged="TitleBarLayout_SizeChanged"
            >
            <ui:TextBox
                x:Name="NavSearchBox"
                Width="400"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"
                VerticalAlignment="Center"
                LostKeyboardFocus="NavSearchBox_LostKeyboardFocus"
                PlaceholderText="Search"
                PreviewKeyDown="NavSearchBox_PreviewKeyDown"
                Style="{StaticResource TitleBarSearchBoxStyle}"
                TextChanged="NavSearchBox_TextChanged"
                WindowChrome.IsHitTestVisibleInChrome="True"
                />
        </ui:TitleBar>
    </ui:FluenceWindow.TitleBar>

    <ui:NavigationView
        x:Name="DemoNav"
        Background="Transparent"
        IsBackButtonVisible="True"
        IsBackEnabled="False"
        IsPaneOpen="True"
        IsPaneToggleButtonVisible="True"
        PaneDisplayMode="Left"
        SelectedIndex="0"
        />
</ui:FluenceWindow>
