<ui:FluenceWindow
    x:Class="Fluence.Wpf.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Fluence.Wpf.Controls;assembly=Fluence.Wpf"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    Title="Fluence.Wpf — Control Gallery"
    Width="1200"
    Height="900"
    MinWidth="698"
    MinHeight="520"
    CornerStyle="Round"
    ExtendsContentIntoTitleBar="True"
    Icon="Resources/AppIcon.png"
    RenderOptions.BitmapScalingMode="HighQuality"
    SnapsToDevicePixels="True"
    SystemBackdropType="Mica"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextHintingMode="Fixed"
    TextOptions.TextRenderingMode="ClearType"
    TitleBarHeight="68"
    UseLayoutRounding="True"
    >

    <ui:FluenceWindow.TitleBar>
        <ui:TitleBar
            x:Name="ShellTitleBar"
            Height="{Binding TitleBarHeight, RelativeSource={RelativeSource AncestorType=ui:FluenceWindow}}"
            Margin="0,0,16,0"
            BackRequested="ShellTitleBar_BackRequested"
            PaneToggleRequested="ShellTitleBar_PaneToggleRequested"
            SizeChanged="TitleBarLayout_SizeChanged"
            >
            <ui:TextBox
                x:Name="NavSearchBox"
                Width="320"
                MinHeight="0"
                Margin="0,8"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                LostKeyboardFocus="NavSearchBox_LostKeyboardFocus"
                PlaceholderText="Search"
                PreviewKeyDown="NavSearchBox_PreviewKeyDown"
                Style="{StaticResource TitleBarSearchBoxStyle}"
                TextChanged="NavSearchBox_TextChanged"
                WindowChrome.IsHitTestVisibleInChrome="True"
                />
        </ui:TitleBar>
    </ui:FluenceWindow.TitleBar>

    <ui:NavigationView
        x:Name="DemoNav"
        Background="Transparent"
        IsBackButtonVisible="True"
        IsBackEnabled="True"
        IsPaneOpen="True"
        IsPaneToggleButtonVisible="True"
        PaneDisplayMode="Top"
        SelectedIndex="0"
        />
</ui:FluenceWindow>
