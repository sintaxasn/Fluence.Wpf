{
  "enabledPlugins": {
    "microsoft-docs@claude-plugins-official": true,
    "wpf-dev-pack@dotnet-claude-plugins": true
  },
  "permissions": {
    "allow": [
      "mcp__microsoft-learn__*",
      "mcp__claude_ai_Microsoft_Learn__*",
      "mcp__HandMirrorMcp__*",
      "Skill(microsoft-docs:*)",
      "Skill(wpf-dev-pack:*)",
      "Agent(winui-parity-reviewer)",
      "Agent(wpf-dev-pack:*)",
      "Agent(wpf-code-reviewer)",
      "Agent(wpf-performance-optimizer)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& { $project = $env:CLAUDE_PROJECT_DIR; if (-not $project) { $project = (Get-Location).Path }; & (Join-Path $project '.claude/hooks/post-tool-util.ps1') }\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
