<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Windows 11 High Contrast Theme - Color fallbacks + Brush overrides  -->
    <!--  Contains BOTH Color keys (static HC defaults) AND Brush keys (live SystemColor references).  -->
    <!--  When HighContrast is active the ThemeManager skips Brushes.xaml and Accent.xaml;  -->
    <!--  this dictionary supplies everything directly so brushes track SystemColor changes.  -->

    <!--  ================================================================  -->
    <!--  SECTION 1 - Color keys (static HC-Black fallback values)  -->
    <!--  These exist so any code that resolves a Color key won't crash.  -->
    <!--  Visual appearance comes from the Brush overrides in Section 2.  -->
    <!--  ================================================================  -->

    <!--  Application Background  -->
    <Color x:Key="ApplicationBackgroundColor">#FF000000</Color>

    <!--  Keyboard Focus  -->
    <Color x:Key="KeyboardFocusBorderColor">#FF1AEBFF</Color>

