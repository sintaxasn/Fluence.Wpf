    <!--  ================================================================  -->
    <!--  SECTION 2 - Brush overrides (live SystemColor DynamicResource)  -->
    <!--  These take visual precedence; they track system HC color changes.  -->
    <!--  ================================================================  -->

    <!--  Application Background  -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />

    <!--  Keyboard Focus  -->
