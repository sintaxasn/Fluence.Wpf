<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Fluence.Wpf.Controls">

    <Style TargetType="{x:Type controls:ProgressRing}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ProgressRing}">
                    <Grid x:Name="RootGrid"
                          Visibility="Visible">

                        <!-- Background track circle -->
                        <Ellipse Stroke="{TemplateBinding Background}"
                                 StrokeThickness="{TemplateBinding StrokeThickness}"
                                 Fill="Transparent" />

                        <!-- Indeterminate spinning arc (using StrokeDashArray on a circle) -->
                        <Ellipse x:Name="PART_IndeterminateRing"
                                 Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding StrokeThickness}"
                                 StrokeDashCap="Round"
                                 StrokeStartLineCap="Round"
                                 StrokeEndLineCap="Round"
                                 StrokeDashArray="3.927 9.817"
                                 Fill="Transparent"
                                 RenderTransformOrigin="0.5,0.5"
                                 Visibility="Visible">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="IndeterminateRotation" Angle="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Determinate arc (data set from code-behind) -->
                        <Path x:Name="PART_DeterminateArc"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="{TemplateBinding StrokeThickness}"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent"
                              Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Indeterminate mode: show spinning ring, hide determinate arc -->
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_IndeterminateRing" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_DeterminateArc" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360"
                                                         Duration="0:0:1.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminateStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Determinate mode: show arc, hide spinning ring -->
                        <Trigger Property="IsIndeterminate" Value="False">
                            <Setter TargetName="PART_IndeterminateRing" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_DeterminateArc" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!-- Inactive: keep track visible, hide animated arcs -->
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="PART_IndeterminateRing" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_DeterminateArc" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RootGrid" Property="Opacity" Value="0.35" />
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootGrid" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
