<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls">

    <Style TargetType="{x:Type controls:ProgressRing}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ProgressRing}">
                    <Grid x:Name="RootGrid" Visibility="Visible">

                        <!--  Background track circle  -->
                        <Ellipse
                            Fill="Transparent"
                            Stroke="{TemplateBinding Background}"
                            StrokeThickness="{TemplateBinding StrokeThickness}" />

                        <!--  Indeterminate spinning arc — StrokeDashArray is set from code-behind  -->
                        <!--  to approximate the WinUI 3 Lottie arc-sweep oscillation.  -->
                        <Ellipse
                            x:Name="PART_IndeterminateRing"
                            Fill="Transparent"
                            RenderTransformOrigin="0.5,0.5"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeDashCap="Round"
                            StrokeThickness="{TemplateBinding StrokeThickness}"
                            Visibility="Visible">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="IndeterminateRotation" Angle="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!--  Determinate arc (data set from code-behind)  -->
                        <Path
                            x:Name="PART_DeterminateArc"
                            Fill="Transparent"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="{TemplateBinding StrokeThickness}"
                            Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--
                            Indeterminate mode: show spinning ring, hide determinate arc.
                            Rotation and arc-sweep animations are started from code-behind
                            (ProgressRing.cs) to allow circumference-aware StrokeDashArray.
                        -->
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_IndeterminateRing" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_DeterminateArc" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  Determinate mode: show arc, hide spinning ring  -->
                        <Trigger Property="IsIndeterminate" Value="False">
                            <Setter TargetName="PART_IndeterminateRing" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_DeterminateArc" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--  Inactive: keep track visible, hide animated arcs  -->
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="PART_IndeterminateRing" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_DeterminateArc" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RootGrid" Property="Opacity" Value="0.35" />
                        </Trigger>

                        <!--  Disabled  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootGrid" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
