<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Fluence.Wpf.Controls"
                    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf">

    <Style x:Key="NavigationViewItemFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Border Margin="-3"
                                BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                SnapsToDevicePixels="True" />
                        <Border Margin="-2"
                                BorderBrush="{DynamicResource FocusStrokeColorInnerBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                SnapsToDevicePixels="True" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:NavigationViewItem}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NavigationViewItemFocusVisual}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NavigationViewItem}">
                    <Border x:Name="OuterBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <Grid Margin="4,2">
                            <Grid x:Name="LeftModeGrid" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="LeftIndicator"
                                        Grid.Column="0"
                                        Width="3"
                                        Margin="0,4,8,4"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource SystemAccentColorBrush}"
                                        CornerRadius="2"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5"
                                        SnapsToDevicePixels="True">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="LeftIndicatorScale" ScaleX="1" ScaleY="0" />
                                    </Border.RenderTransform>
                                </Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="IconLeft"
                                                      Content="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0" />
                                    <ContentPresenter x:Name="LabelLeft"
                                                      Content="{TemplateBinding Content}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="TopModeGrid" Visibility="Collapsed" Margin="4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="IconTop"
                                                      Content="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />
                                    <ContentPresenter x:Name="LabelTop"
                                                      Content="{TemplateBinding Content}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />
                                </StackPanel>
                                <Border x:Name="TopIndicator"
                                        Grid.Row="1"
                                        Height="3"
                                        Margin="8,4,8,0"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource SystemAccentColorBrush}"
                                        CornerRadius="2"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5"
                                        SnapsToDevicePixels="True">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="TopIndicatorScale" ScaleX="0" ScaleY="1" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="{x:Static uicore:NavigationViewPaneDisplayMode.Top}">
                            <Setter TargetName="LeftModeGrid" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TopModeGrid" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="False" />
                                <Condition Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="{x:Static uicore:NavigationViewPaneDisplayMode.Left}" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="LabelLeft" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconLeft" Property="Margin" Value="0" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition SourceName="LeftModeGrid" Property="Visibility" Value="Visible" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="LeftIndicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.05" />
                                        <DoubleAnimation Storyboard.TargetName="LeftIndicatorScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0" To="1"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="LeftIndicatorScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0"
                                                         Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="LeftIndicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.1"
                                                         BeginTime="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition SourceName="TopModeGrid" Property="Visibility" Value="Visible" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TopIndicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.05" />
                                        <DoubleAnimation Storyboard.TargetName="TopIndicatorScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="0" To="1"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TopIndicatorScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0"
                                                         Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TopIndicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.1"
                                                         BeginTime="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="{x:Static uicore:NavigationViewPaneDisplayMode.Top}">
                <Setter Property="Margin" Value="0,0,4,0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- NavigationViewBackButton: shared chrome -->
    <ControlTemplate x:Key="NavigationViewBackButtonTemplate" TargetType="Button">
        <Border x:Name="bbnav"
                Background="Transparent"
                CornerRadius="4"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bbnav" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bbnav" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="NavigationViewLeftPaneTemplate" TargetType="{x:Type controls:NavigationView}">
        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Padding="4,6,8,6"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Background="{DynamicResource LayerFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PART_BackButton"
                                Width="40"
                                Height="36"
                                MinWidth="40"
                                MinHeight="36"
                                Padding="0"
                                Margin="0,0,8,0"
                                Focusable="True"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                Template="{StaticResource NavigationViewBackButtonTemplate}">
                            <controls:FontIcon Glyph="&#xE72B;" IconFontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Button>
                        <ContentPresenter Content="{TemplateBinding PaneHeader}" VerticalAlignment="Center" />
                        <ContentPresenter Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PaneColumn" Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          Padding="4,8">
                                <ItemsPresenter />
                            </ScrollViewer>
                            <Border Grid.Row="1" Padding="8,0,8,8">
                                <ContentPresenter Content="{TemplateBinding PaneFooter}" />
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="{TemplateBinding ContentBackground}">
                        <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsBackButtonVisible" Value="False">
                <Setter TargetName="PART_BackButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsBackEnabled" Value="False">
                <Setter TargetName="PART_BackButton" Property="IsEnabled" Value="False" />
            </Trigger>
            <Trigger Property="IsPaneOpen" Value="False">
                <Setter TargetName="PaneColumn" Property="Width" Value="48" />
            </Trigger>
            <Trigger Property="IsPaneOpen" Value="True">
                <Setter TargetName="PaneColumn" Property="Width" Value="280" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="NavigationViewTopPaneTemplate" TargetType="{x:Type controls:NavigationView}">
        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="4,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PART_BackButton"
                                Grid.Column="0"
                                Width="40"
                                Height="36"
                                MinWidth="40"
                                MinHeight="36"
                                Padding="0"
                                Margin="8,0,4,0"
                                Focusable="True"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                Template="{StaticResource NavigationViewBackButtonTemplate}">
                            <controls:FontIcon Glyph="&#xE72B;" IconFontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Button>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding PaneHeader}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                        <ScrollViewer Grid.Column="2"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Auto"
                                      Focusable="False"
                                      VerticalAlignment="Center">
                            <ItemsPresenter />
                        </ScrollViewer>
                        <ContentPresenter Grid.Column="3"
                                          Content="{TemplateBinding PaneFooter}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="{TemplateBinding ContentBackground}">
                    <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                </Border>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsBackButtonVisible" Value="False">
                <Setter TargetName="PART_BackButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsBackEnabled" Value="False">
                <Setter TargetName="PART_BackButton" Property="IsEnabled" Value="False" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type controls:NavigationView}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ContentBackground" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Focusable="False" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template" Value="{StaticResource NavigationViewLeftPaneTemplate}" />
        <Style.Triggers>
            <Trigger Property="PaneDisplayMode" Value="{x:Static uicore:NavigationViewPaneDisplayMode.Top}">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Focusable="False" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template" Value="{StaticResource NavigationViewTopPaneTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
