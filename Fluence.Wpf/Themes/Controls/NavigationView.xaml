<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls"
    xmlns:helpers="clr-namespace:Fluence.Wpf.Helpers"
    xmlns:uicore="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf"
    >

    <!--  NavigationViewItemHeader  -->
    <Style TargetType="{x:Type controls:NavigationViewItemHeader}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Padding" Value="12,8,12,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NavigationViewItemHeader}">
                    <Border Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--  Left mode + pane closed: 48-px compact strip has no room for text headers  -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="False" />
                    <Condition Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="{x:Static uicore:NavigationViewPaneDisplayMode.Left}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
            <!--  LeftCompact mode: always compact (48-px pane, no text headers ever)  -->
            <DataTrigger Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="{x:Static uicore:NavigationViewPaneDisplayMode.LeftCompact}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <!--  Top mode: inline horizontal items leave no room for section headers  -->
            <DataTrigger Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="{x:Static uicore:NavigationViewPaneDisplayMode.Top}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  NavigationViewItemSeparator  -->
    <Style TargetType="{x:Type controls:NavigationViewItemSeparator}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12,4,0,4" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NavigationViewItemSeparator}">
                    <Border
                        Height="{TemplateBinding Height}"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Focus visual shared by NavigationViewItem  -->
    <Style x:Key="NavigationViewItemFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Border
                            Margin="0"
                            BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}"
                            BorderThickness="2"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            />
                        <Border
                            Margin="2"
                            BorderBrush="{DynamicResource FocusStrokeColorInnerBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  NavigationViewItem — single adaptive layout, no per-item indicator  -->
    <Style TargetType="{x:Type controls:NavigationViewItem}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource NavigationViewItemFocusVisual}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NavigationViewItem}">
                    <ControlTemplate.Resources>
                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="TextWrapping" Value="NoWrap" />
                        </Style>
                    </ControlTemplate.Resources>
                    <Border
                        x:Name="OuterBorder"
                        Margin="4,2,4,2"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        >
                        <Grid MinHeight="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="IconColumn" Width="40" />
                                <ColumnDefinition x:Name="GapColumn" Width="12" />
                                <ColumnDefinition x:Name="ContentColumn" Width="*" />
                                <ColumnDefinition x:Name="InfoBadgeColumn" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--  Selection indicator removed — pane-level PART_SelectionIndicator (Left/LeftCompact/Top pane templates) owns the selection visual.  -->
                            <ContentPresenter
                                x:Name="IconPresenter"
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                />
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                RecognizesAccessKey="True"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                />
                            <ContentPresenter
                                x:Name="InfoBadgePresenter"
                                Grid.Column="3"
                                Width="24"
                                Height="32"
                                Margin="4,0,8,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{Binding InfoBadge, RelativeSource={RelativeSource TemplatedParent}}"
                                />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Top mode: hide icon, adjust margin, hide selection pill  -->
                        <DataTrigger Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="{x:Static uicore:NavigationViewPaneDisplayMode.Top}">
                            <Setter TargetName="IconColumn" Property="Width" Value="0" />
                            <Setter TargetName="GapColumn" Property="Width" Value="0" />
                            <Setter TargetName="InfoBadgeColumn" Property="Width" Value="0" />
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InfoBadgePresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="OuterBorder" Property="Margin" Value="2,4" />
                            <Setter TargetName="OuterBorder" Property="Padding" Value="8,0" />
                            <Setter Property="FontSize" Value="12" />
                        </DataTrigger>
                        <!--  Left + pane closed: hide label and center icon in 48px pane  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="False" />
                                <Condition Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="{x:Static uicore:NavigationViewPaneDisplayMode.Left}" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InfoBadgePresenter" Property="Visibility" Value="Collapsed" />
                            <!--  IconColumn held at fixed 40 px so the icon center stays at x=24 (4px margin + 40/2) during pane-width animation. Making it * would re-centre in the intermediate item width and slide laterally.  -->
                            <Setter TargetName="GapColumn" Property="Width" Value="0" />
                            <Setter TargetName="ContentColumn" Property="Width" Value="0" />
                            <Setter TargetName="InfoBadgeColumn" Property="Width" Value="0" />
                        </MultiDataTrigger>
                        <!--  LeftCompact + pane closed: hide label and center icon in 48px pane  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="False" />
                                <Condition Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="{x:Static uicore:NavigationViewPaneDisplayMode.LeftCompact}" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InfoBadgePresenter" Property="Visibility" Value="Collapsed" />
                            <!--  IconColumn held at fixed 40 px so the icon center stays at x=24 (4px margin + 40/2) during pane-width animation. Making it * would re-centre in the intermediate item width and slide laterally.  -->
                            <Setter TargetName="GapColumn" Property="Width" Value="0" />
                            <Setter TargetName="ContentColumn" Property="Width" Value="0" />
                            <Setter TargetName="InfoBadgeColumn" Property="Width" Value="0" />
                        </MultiDataTrigger>
                        <!--  Selected  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <!--  Hover (not selected)  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </MultiTrigger>
                        <!--  Hover + selected  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </MultiTrigger>
                        <!--  Pressed (not selected)  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </MultiTrigger>
                        <!--  Pressed + selected  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsSelected" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </MultiTrigger>
                        <!--  Disabled  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="{x:Static uicore:NavigationViewPaneDisplayMode.Top}">
                <Setter Property="Margin" Value="0,0,4,0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  NavigationViewBackButton: shared chrome  -->
    <ControlTemplate x:Key="NavigationViewBackButtonTemplate" TargetType="Button">
        <Border
            x:Name="BackBorder"
            Background="Transparent"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            >
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BackBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="BackBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  Left pane template  -->
    <ControlTemplate x:Key="NavigationViewLeftPaneTemplate" TargetType="{x:Type controls:NavigationView}">
        <Border Background="{TemplateBinding Background}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PaneColumn" Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Pane background: Transparent so DWM Mica/Acrylic backdrop shows through.  -->
                <Border
                    x:Name="PaneBorder"
                    Grid.Column="0"
                    Background="Transparent"
                    >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            x:Name="PaneChrome"
                            Grid.Row="0"
                            MinWidth="48"
                            Height="48"
                            Margin="0"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            >
                            <Button
                                x:Name="PART_BackButton"
                                Width="48"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="True"
                                Template="{StaticResource NavigationViewBackButtonTemplate}"
                                Visibility="Collapsed"
                                >
                                <controls:FontIcon
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Glyph="&#xE72B;"
                                    IconFontSize="16"
                                    />
                            </Button>
                            <Button
                                x:Name="PART_PaneToggleButton"
                                Width="48"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="True"
                                Template="{StaticResource NavigationViewBackButtonTemplate}"
                                >
                                <controls:FontIcon
                                    x:Name="PaneToggleGlyph"
                                    Margin="2,0,0,0"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Glyph="&#xE700;"
                                    IconFontSize="16"
                                    />
                            </Button>
                        </StackPanel>

                        <!--  Padding="3,4": 3px horizontal gives focus-ring Margin="-3" clearance so it is not clipped.  -->
                        <controls:SmoothScrollViewer
                            x:Name="PART_PaneItemsScrollViewer"
                            Grid.Row="1"
                            Padding="3,4"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            Style="{DynamicResource ScrollViewerStyle}"
                            VerticalScrollBarVisibility="Auto"
                            >
                            <Grid>
                                <ItemsPresenter />
                                <Border
                                    x:Name="PART_SelectionIndicator"
                                    Width="3"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="1.5"
                                    IsHitTestVisible="False"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5"
                                    >
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <TranslateTransform />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </controls:SmoothScrollViewer>

                        <Border Grid.Row="2" Padding="8,0,8,8">
                            <ContentPresenter Content="{TemplateBinding PaneFooter}" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="HeaderRow" Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ContentPresenter
                        Grid.Row="0"
                        Margin="24,0,24,0"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                        >
                        <ContentPresenter.Style>
                            <Style TargetType="ContentPresenter">
                                <Style.Triggers>
                                    <Trigger Property="Content" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentPresenter.Style>
                    </ContentPresenter>
                    <Grid Grid.Row="1">
                        <!--
                            Rounded content background and the 1 px stroke are split so
                            PART_ContentPresenter sits flush with the pane column edge.
                            WI-1 F1 regression: wrapping the presenter in a BorderThickness=1
                            Border pushed content.X to 281.333 at 150% DPI (1 logical px
                            snaps to 1.333 at 150%), causing the pane-layout tests to fail.
                        -->
                        <Border
                            Background="{TemplateBinding ContentBackground}"
                            ClipToBounds="True"
                            CornerRadius="8,0,0,0"
                            >
                            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                        </Border>
                        <Border
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1,1,0,0"
                            CornerRadius="8,0,0,0"
                            IsHitTestVisible="False"
                            />
                    </Grid>
                </Grid>
            </Grid>
            <!--  WI-3 B15: BackButtonStates VSM group - WinUI NavigationView canonical  -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="BackButtonStates">
                    <VisualState x:Name="BackButtonVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_BackButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="BackButtonCollapsed">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_BackButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
                <Setter TargetName="HeaderRow" Property="Height" Value="42" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}" />
                    <Condition Binding="{Binding ExtendsContentIntoTitleBar, RelativeSource={RelativeSource AncestorType=controls:FluenceWindow}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="HeaderRow" Property="Height" Value="48" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding ExtendsContentIntoTitleBar, RelativeSource={RelativeSource AncestorType=controls:FluenceWindow}}" Value="True">
                <Setter TargetName="PaneChrome" Property="Height" Value="48" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsBackButtonVisible" Value="True" />
                    <Condition Property="IsBackEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_BackButton" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsPaneToggleButtonVisible" Value="False">
                <Setter TargetName="PART_PaneToggleButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsPaneOpen" Value="True">
                <Setter TargetName="PaneColumn" Property="Width" Value="280" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <helpers:GridLengthAnimation
                                Storyboard.TargetName="PaneColumn"
                                Storyboard.TargetProperty="Width"
                                To="280"
                                Duration="0:0:0.167"
                                FillBehavior="Stop"
                                >
                                <helpers:GridLengthAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </helpers:GridLengthAnimation.EasingFunction>
                            </helpers:GridLengthAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <helpers:GridLengthAnimation
                                Storyboard.TargetName="PaneColumn"
                                Storyboard.TargetProperty="Width"
                                To="48"
                                Duration="0:0:0.167"
                                FillBehavior="Stop"
                                >
                                <helpers:GridLengthAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseIn" />
                                </helpers:GridLengthAnimation.EasingFunction>
                            </helpers:GridLengthAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPaneOpen" Value="False" />
                    <Condition Property="IsBackButtonVisible" Value="True" />
                    <Condition Property="IsBackEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PaneColumn" Property="Width" Value="96" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  Left-compact pane template  -->
    <ControlTemplate x:Key="NavigationViewLeftCompactPaneTemplate" TargetType="{x:Type controls:NavigationView}">
        <Border>
            <!--
                Two-column inline layout: pane resizes between 48 and 280 and pushes content.
                This mirrors WinUI 3 NavigationView / .NET 10 WPF NavigationView compact-left
                behavior and replaces the previous Panel.ZIndex overlay approach.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PaneColumn" Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Pane background: Transparent so DWM Mica/Acrylic backdrop shows through.  -->
                <Border
                    x:Name="CompactPane"
                    Grid.Column="0"
                    Background="Transparent"
                    >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            x:Name="PaneChrome"
                            Grid.Row="0"
                            MinWidth="48"
                            Height="42"
                            Margin="0"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            >
                            <Button
                                x:Name="PART_BackButton"
                                Width="48"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="True"
                                Template="{StaticResource NavigationViewBackButtonTemplate}"
                                Visibility="Collapsed"
                                >
                                <controls:FontIcon
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Glyph="&#xE72B;"
                                    IconFontSize="16"
                                    />
                            </Button>
                            <Button
                                x:Name="PART_PaneToggleButton"
                                Width="48"
                                Height="40"
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="True"
                                Template="{StaticResource NavigationViewBackButtonTemplate}"
                                >
                                <controls:FontIcon
                                    x:Name="PaneToggleGlyph"
                                    Margin="2,0,0,0"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Glyph="&#xE700;"
                                    IconFontSize="16"
                                    />
                            </Button>
                        </StackPanel>

                        <!--  Padding="3,4": 3px horizontal gives focus-ring Margin="-3" clearance so it is not clipped.  -->
                        <controls:SmoothScrollViewer
                            x:Name="PART_PaneItemsScrollViewer"
                            Grid.Row="1"
                            Padding="3,4"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            Style="{DynamicResource ScrollViewerStyle}"
                            VerticalScrollBarVisibility="Auto"
                            >
                            <Grid>
                                <ItemsPresenter />
                                <Border
                                    x:Name="PART_SelectionIndicator"
                                    Width="3"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="1.5"
                                    IsHitTestVisible="False"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5"
                                    >
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <TranslateTransform />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </controls:SmoothScrollViewer>

                        <Border
                            x:Name="PaneFooterHost"
                            Grid.Row="2"
                            Padding="8,0,8,8"
                            >
                            <ContentPresenter Content="{TemplateBinding PaneFooter}" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="HeaderRow" Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ContentPresenter
                        Grid.Row="0"
                        Margin="24,0,24,0"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                        >
                        <ContentPresenter.Style>
                            <Style TargetType="ContentPresenter">
                                <Style.Triggers>
                                    <Trigger Property="Content" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentPresenter.Style>
                    </ContentPresenter>
                    <Grid Grid.Row="1">
                        <!--
                            Rounded content background and the 1 px stroke are split so
                            PART_ContentPresenter sits flush with the pane column edge.
                            WI-1 F1 regression: wrapping the presenter in a BorderThickness=1
                            Border pushed content.X to 281.333 at 150% DPI (1 logical px
                            snaps to 1.333 at 150%), causing the pane-layout tests to fail.
                        -->
                        <Border
                            Background="{TemplateBinding ContentBackground}"
                            ClipToBounds="True"
                            CornerRadius="8,0,0,0"
                            >
                            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                        </Border>
                        <Border
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1,1,0,0"
                            CornerRadius="8,0,0,0"
                            IsHitTestVisible="False"
                            />
                    </Grid>
                </Grid>
            </Grid>
            <!--  WI-3 B15: BackButtonStates VSM group - WinUI NavigationView canonical  -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="BackButtonStates">
                    <VisualState x:Name="BackButtonVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_BackButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="BackButtonCollapsed">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_BackButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
                <Setter TargetName="HeaderRow" Property="Height" Value="42" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}" />
                    <Condition Binding="{Binding ExtendsContentIntoTitleBar, RelativeSource={RelativeSource AncestorType=controls:FluenceWindow}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="HeaderRow" Property="Height" Value="42" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding ExtendsContentIntoTitleBar, RelativeSource={RelativeSource AncestorType=controls:FluenceWindow}}" Value="True">
                <Setter TargetName="PaneChrome" Property="Height" Value="42" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsBackButtonVisible" Value="True" />
                    <Condition Property="IsBackEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_BackButton" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsPaneToggleButtonVisible" Value="False">
                <Setter TargetName="PART_PaneToggleButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsPaneOpen" Value="True">
                <Setter TargetName="PaneColumn" Property="Width" Value="280" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <helpers:GridLengthAnimation
                                Storyboard.TargetName="PaneColumn"
                                Storyboard.TargetProperty="Width"
                                To="280"
                                Duration="0:0:0.167"
                                FillBehavior="Stop"
                                >
                                <helpers:GridLengthAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </helpers:GridLengthAnimation.EasingFunction>
                            </helpers:GridLengthAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <helpers:GridLengthAnimation
                                Storyboard.TargetName="PaneColumn"
                                Storyboard.TargetProperty="Width"
                                To="48"
                                Duration="0:0:0.167"
                                FillBehavior="Stop"
                                >
                                <helpers:GridLengthAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseIn" />
                                </helpers:GridLengthAnimation.EasingFunction>
                            </helpers:GridLengthAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPaneOpen" Value="False">
                <Setter TargetName="PaneFooterHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPaneOpen" Value="False" />
                    <Condition Property="IsBackButtonVisible" Value="True" />
                    <Condition Property="IsBackEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PaneColumn" Property="Width" Value="96" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  Top pane template  -->
    <ControlTemplate x:Key="NavigationViewTopPaneTemplate" TargetType="{x:Type controls:NavigationView}">
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{DynamicResource OverlayCornerRadius}"
            >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  Pane background: Transparent so DWM Mica/Acrylic backdrop shows through.  -->
                <Border
                    x:Name="PaneHeaderBorder"
                    Grid.Row="0"
                    Padding="4,0,8,0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="PART_BackButton"
                            Grid.Column="0"
                            Margin="24,0,4,0"
                            Padding="6"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="True"
                            Template="{StaticResource NavigationViewBackButtonTemplate}"
                            Visibility="Collapsed"
                            >
                            <controls:FontIcon
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Glyph="&#xE72B;"
                                IconFontSize="20"
                                />
                        </Button>
                        <ContentPresenter
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding PaneHeader}"
                            />
                        <controls:SmoothScrollViewer
                            x:Name="PART_PaneItemsScrollViewer"
                            Grid.Column="2"
                            VerticalAlignment="Stretch"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Auto"
                            Style="{DynamicResource ScrollViewerStyle}"
                            VerticalScrollBarVisibility="Disabled"
                            >
                            <Grid>
                                <ItemsPresenter VerticalAlignment="Center" />
                                <Border
                                    x:Name="PART_SelectionIndicator"
                                    Width="16"
                                    Height="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="1.5"
                                    IsHitTestVisible="False"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5"
                                    >
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <TranslateTransform />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </controls:SmoothScrollViewer>
                        <ContentPresenter
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding PaneFooter}"
                            />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="{TemplateBinding ContentBackground}">
                    <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                </Border>
            </Grid>
            <!--  WI-3 B15: BackButtonStates VSM group - WinUI NavigationView canonical  -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="BackButtonStates">
                    <VisualState x:Name="BackButtonVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_BackButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="BackButtonCollapsed">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_BackButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsBackButtonVisible" Value="True" />
                    <Condition Property="IsBackEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_BackButton" Property="Visibility" Value="Visible" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  NavigationView default style  -->
    <Style TargetType="{x:Type controls:NavigationView}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ContentBackground" Value="{DynamicResource NavigationViewContentBackgroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Focusable="False" Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template" Value="{StaticResource NavigationViewLeftPaneTemplate}" />
        <Style.Triggers>
            <Trigger Property="PaneDisplayMode" Value="{x:Static uicore:NavigationViewPaneDisplayMode.Top}">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Focusable="False" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template" Value="{StaticResource NavigationViewTopPaneTemplate}" />
            </Trigger>
            <Trigger Property="PaneDisplayMode" Value="{x:Static uicore:NavigationViewPaneDisplayMode.LeftCompact}">
                <Setter Property="Template" Value="{StaticResource NavigationViewLeftCompactPaneTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
