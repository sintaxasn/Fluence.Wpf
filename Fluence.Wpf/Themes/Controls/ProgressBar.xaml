<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Fluence.Wpf.Controls">

    <Style TargetType="{x:Type controls:ProgressBar}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Value" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ProgressBar}">
                    <Grid>
                        <Border x:Name="PART_Track"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                ClipToBounds="True"
                                Height="{TemplateBinding TrackHeight}"
                                VerticalAlignment="Center">
                            <Grid>
                                <Border x:Name="PART_Fill"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Width="0" />
                                <Border x:Name="PART_IndeterminateBar"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Visibility="Collapsed"
                                        Width="0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="PART_IndeterminateTranslate" X="0" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="PART_IndeterminateBar2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource AccentFillColorSecondaryBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Visibility="Collapsed"
                                        Width="0"
                                        Opacity="0.9">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="PART_IndeterminateTranslate2" X="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                            <Setter TargetName="PART_Fill" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
