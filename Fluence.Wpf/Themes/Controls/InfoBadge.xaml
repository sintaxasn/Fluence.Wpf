<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fluence.Wpf.Controls"
    xmlns:fluence="clr-namespace:Fluence.Wpf">

    <Style TargetType="{x:Type controls:InfoBadge}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FluentFontFamily}" />
        <!--  WinUI InfoBadgeValueFontSize = 11 (InfoBadge_themeresources.xaml:10). The weight is WPF's own: WinUI's value text inherits the default body weight at 11, which reads thin against an accent fill here, so SemiBold holds the small numeral legible.  -->
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <!--  WinUI keys the badge's own foreground (InfoBadgeForeground, InfoBadge_themeresources.xaml:5) rather than reusing a text token, because the numeral sits on a filled capsule and has to pair with whatever that plate is. Outside high contrast all five severities resolve to the on-accent text colour, as WinUI's does; in high contrast they split, because the Attention plate is the system highlight and the other four are the window text colour.  -->
        <Setter Property="Foreground" Value="{DynamicResource InfoBadgeAttentionForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <!--  WinUI InfoBadge is IsTabStop False (InfoBadge_themeresources.xaml:54). WPF's Control also defaults Focusable to true, which WinUI's does not, so a badge inside a NavigationViewItem would otherwise be Tab reachable and take focus on click.  -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <!--  WinUI InfoBadgeMaxHeight = 16, InfoBadgeMinHeight = InfoBadgeMinWidth = 4, InfoBadgePadding = 0 (InfoBadge_themeresources.xaml:7-13). The 4 dip floor is the dot; the 16 dip ceiling is the value and icon pill.  -->
        <Setter Property="MaxHeight" Value="16" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InfoBadge}">
                    <Grid>
                        <!--  The radius follows the measured height: InfoBadge recomputes it as half the height on every size change, the way WinUI feeds TemplateSettings.InfoBadgeCornerRadius (InfoBadge.cpp OnSizeChanged), so the capsule stays a capsule at any height between the 4 dip dot and the 16 dip pill.  -->
                        <Border
                            x:Name="BadgeBorder"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            MaxHeight="{TemplateBinding MaxHeight}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <!--
                                The inset is per display kind, which is why it is not on this element: WinUI gives a
                                value or a font glyph ValueInfoBadgeTextMargin / IconInfoBadgeFontIconMargin 4,0,4,2
                                and a drawn icon the uniform IconInfoBadgeIconMargin 4,4,4,4
                                (InfoBadge_themeresources.xaml:14-16). The states below apply whichever one the kind
                                calls for.

                                The horizontal 4s are WinUI's and set the capsule's width. The vertical 2 is not
                                carried: it nudges WinUI's own digits optically, and WPF's line box for 11 dip Segoe
                                UI Variable is already the full 16 dip of the pill, so the same inset arranges the
                                text into 14 and clips it, low in the capsule. Dropping it lets VerticalAlignment
                                centre the text in the pill, which is where WinUI's lands.
                            -->
                            <ContentPresenter
                                x:Name="ContentArea"
                                Margin="4,0,4,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.FontWeight="{TemplateBinding FontWeight}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <!--  Dot mode: the 4 dip floor WinUI's InfoBadgeMinHeight / InfoBadgeMinWidth leave when the badge has neither a value nor an icon.  -->
                        <Ellipse
                            x:Name="DotIndicator"
                            Width="4"
                            Height="4"
                            Fill="{TemplateBinding Background}"
                            Visibility="Collapsed" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="DisplayKindStates">
                                <!--  Dot: no value, no icon - show small circle, hide pill  -->
                                <VisualState x:Name="Dot">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BadgeBorder" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DotIndicator" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <!--  Icon / FontIcon / Value: show the pill. A drawn icon takes WinUI's uniform 4,4,4,4; a font glyph and a value keep the 4,0,4,2 the presenter already carries.  -->
                                <VisualState x:Name="Icon">
                                    <Storyboard>
                                        <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="ContentArea" Storyboard.TargetProperty="Margin">
                                            <DiscreteThicknessKeyFrame KeyTime="0" Value="4,4,4,4" />
                                        </ThicknessAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="FontIcon" />
                                <VisualState x:Name="Value" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  Severity colors  -->
                        <Trigger Property="BadgeStyle" Value="{x:Static fluence:InfoBadgeStyle.Informational}">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource SystemFillColorSolidNeutralBrush}" />
                            <Setter TargetName="DotIndicator" Property="Fill" Value="{DynamicResource SystemFillColorSolidNeutralBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InfoBadgeInformationalForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="BadgeStyle" Value="{x:Static fluence:InfoBadgeStyle.Success}">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            <Setter TargetName="DotIndicator" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InfoBadgeSuccessForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="BadgeStyle" Value="{x:Static fluence:InfoBadgeStyle.Critical}">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Setter TargetName="DotIndicator" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InfoBadgeCriticalForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="BadgeStyle" Value="{x:Static fluence:InfoBadgeStyle.Caution}">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            <Setter TargetName="DotIndicator" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InfoBadgeCautionForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
