<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Windows 11 Fluent - Brush layer  -->
    <!--  Every brush resolves its Color via DynamicResource to a Color key defined in Colors/Theme.*.xaml.  -->
    <!--  Accent brushes are in Accent/Accent.xaml - do NOT duplicate them here.  -->
    <!--  This dictionary is NOT loaded in HighContrast mode; Theme.HighContrast.xaml supplies its own brushes.  -->

    <!--  Application Background  -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{DynamicResource ApplicationBackgroundColor}" />

    <!--  Keyboard Focus  -->
    <SolidColorBrush x:Key="KeyboardFocusBorderColorBrush" Color="{DynamicResource KeyboardFocusBorderColor}" />

    <!--  Text Fill Colors  -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{DynamicResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{DynamicResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{DynamicResource TextFillColorTertiary}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{DynamicResource TextFillColorDisabled}" />
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="{DynamicResource TextPlaceholderColor}" />
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="{DynamicResource TextFillColorInverse}" />

    <!--  Control Fill Colors  -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{DynamicResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{DynamicResource ControlFillColorSecondary}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{DynamicResource ControlFillColorTertiary}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{DynamicResource ControlFillColorDisabled}" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="{DynamicResource ControlFillColorTransparent}" />
    <SolidColorBrush x:Key="ControlFillColorQuarternaryBrush" Color="{DynamicResource ControlFillColorQuarternary}" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{DynamicResource ControlFillColorInputActive}" />

    <!--  Control Strong Fill Colors  -->
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="{DynamicResource ControlStrongFillColorDefault}" />
    <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="{DynamicResource ControlStrongFillColorDisabled}" />

    <!--  Control Solid Fill Colors  -->
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="{DynamicResource ControlSolidFillColorDefault}" />

    <!--  Subtle Fill Colors  -->
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="{DynamicResource SubtleFillColorTransparent}" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{DynamicResource SubtleFillColorSecondary}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{DynamicResource SubtleFillColorTertiary}" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="{DynamicResource SubtleFillColorDisabled}" />

    <!--  Control Alt Fill Colors  -->
    <SolidColorBrush x:Key="ControlAltFillColorTransparentBrush" Color="{DynamicResource ControlAltFillColorTransparent}" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="{DynamicResource ControlAltFillColorSecondary}" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="{DynamicResource ControlAltFillColorTertiary}" />
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="{DynamicResource ControlAltFillColorQuarternary}" />
    <SolidColorBrush x:Key="ControlAltFillColorDisabledBrush" Color="{DynamicResource ControlAltFillColorDisabled}" />

    <!--  Control On Image Fill Colors  -->
    <SolidColorBrush x:Key="ControlOnImageFillColorDefaultBrush" Color="{DynamicResource ControlOnImageFillColorDefault}" />
    <SolidColorBrush x:Key="ControlOnImageFillColorSecondaryBrush" Color="{DynamicResource ControlOnImageFillColorSecondary}" />
    <SolidColorBrush x:Key="ControlOnImageFillColorTertiaryBrush" Color="{DynamicResource ControlOnImageFillColorTertiary}" />
    <SolidColorBrush x:Key="ControlOnImageFillColorDisabledBrush" Color="{DynamicResource ControlOnImageFillColorDisabled}" />

    <!--  Control Stroke Colors  -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{DynamicResource ControlStrokeColorSecondary}" />
    <SolidColorBrush x:Key="ControlStrokeColorTertiaryBrush" Color="{DynamicResource ControlStrokeColorTertiary}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="{DynamicResource ControlStrokeColorOnAccentDefault}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="{DynamicResource ControlStrokeColorOnAccentSecondary}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentTertiaryBrush" Color="{DynamicResource ControlStrokeColorOnAccentTertiary}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDisabledBrush" Color="{DynamicResource ControlStrokeColorOnAccentDisabled}" />
    <SolidColorBrush x:Key="ControlStrokeColorForStrongFillWhenOnImageBrush" Color="{DynamicResource ControlStrokeColorForStrongFillWhenOnImage}" />

    <!--  Card Stroke Colors  -->
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{DynamicResource CardStrokeColorDefault}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="{DynamicResource CardStrokeColorDefaultSolid}" />

    <!--  Control Strong Stroke Colors  -->
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{DynamicResource ControlStrongStrokeColorDefault}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="{DynamicResource ControlStrongStrokeColorDisabled}" />

    <!--  Surface Stroke Colors  -->
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{DynamicResource SurfaceStrokeColorDefault}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="{DynamicResource SurfaceStrokeColorFlyout}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorInverseBrush" Color="{DynamicResource SurfaceStrokeColorInverse}" />

    <!--  Divider Stroke Color  -->
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{DynamicResource DividerStrokeColorDefault}" />

    <!--  Focus Stroke Colors  -->
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{DynamicResource FocusStrokeColorOuter}" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="{DynamicResource FocusStrokeColorInner}" />

    <!--  Card Background Fill Colors  -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{DynamicResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{DynamicResource CardBackgroundFillColorSecondary}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorTertiaryBrush" Color="{DynamicResource CardBackgroundFillColorTertiary}" />

    <!--  Smoke Fill Color  -->
    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="{DynamicResource SmokeFillColorDefault}" />

    <!--  Layer Fill Colors  -->
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{DynamicResource LayerFillColorDefault}" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{DynamicResource LayerFillColorAlt}" />
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="{DynamicResource LayerOnAcrylicFillColorDefault}" />
    <SolidColorBrush x:Key="LayerOnAccentAcrylicFillColorDefaultBrush" Color="{DynamicResource LayerOnAccentAcrylicFillColorDefault}" />

    <!--  Layer On Mica Base Alt Fill Colors  -->
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="{DynamicResource LayerOnMicaBaseAltFillColorDefault}" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" Color="{DynamicResource LayerOnMicaBaseAltFillColorSecondary}" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTertiaryBrush" Color="{DynamicResource LayerOnMicaBaseAltFillColorTertiary}" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTransparentBrush" Color="{DynamicResource LayerOnMicaBaseAltFillColorTransparent}" />

    <!--  Solid Background Fill Colors  -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{DynamicResource SolidBackgroundFillColorBase}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{DynamicResource SolidBackgroundFillColorSecondary}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{DynamicResource SolidBackgroundFillColorTertiary}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{DynamicResource SolidBackgroundFillColorQuarternary}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTransparentBrush" Color="{DynamicResource SolidBackgroundFillColorTransparent}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuinaryBrush" Color="{DynamicResource SolidBackgroundFillColorQuinary}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSenaryBrush" Color="{DynamicResource SolidBackgroundFillColorSenary}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{DynamicResource SolidBackgroundFillColorBaseAlt}" />

    <!--  NavigationView content area (semi-transparent tint over Mica/Acrylic backdrop)  -->
    <SolidColorBrush x:Key="NavigationViewContentBackgroundBrush" Color="{DynamicResource NavigationViewContentBackground}" />

    <!--  Acrylic Background Fill Colors  -->
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="{DynamicResource AcrylicBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorBaseBrush" Color="{DynamicResource AcrylicBackgroundFillColorBase}" />

    <!--  System Fill Colors  -->
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{DynamicResource SystemFillColorAttention}" />
    <SolidColorBrush x:Key="SystemFillColorInformationalBrush" Color="{DynamicResource SystemFillColorInformational}" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{DynamicResource SystemFillColorSuccess}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{DynamicResource SystemFillColorCaution}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{DynamicResource SystemFillColorCritical}" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="{DynamicResource SystemFillColorNeutral}" />
    <SolidColorBrush x:Key="SystemFillColorSolidNeutralBrush" Color="{DynamicResource SystemFillColorSolidNeutral}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="{DynamicResource SystemFillColorAttentionBackground}" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="{DynamicResource SystemFillColorSuccessBackground}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="{DynamicResource SystemFillColorCautionBackground}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="{DynamicResource SystemFillColorCriticalBackground}" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="{DynamicResource SystemFillColorNeutralBackground}" />
    <SolidColorBrush x:Key="SystemFillColorSolidAttentionBackgroundBrush" Color="{DynamicResource SystemFillColorSolidAttentionBackground}" />
    <SolidColorBrush x:Key="SystemFillColorSolidNeutralBackgroundBrush" Color="{DynamicResource SystemFillColorSolidNeutralBackground}" />

    <!--  High contrast SystemColor aliases used by the WinUI Gallery color guidance page.  -->
    <SolidColorBrush x:Key="SystemColorWindowTextColorBrush" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="SystemColorWindowColorBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="SystemColorButtonFaceColorBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="SystemColorButtonTextColorBrush" Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}" />
    <SolidColorBrush x:Key="SystemColorHighlightColorBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="SystemColorHighlightTextColorBrush" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="SystemColorHotlightColorBrush" Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}" />
    <SolidColorBrush x:Key="SystemColorGrayTextColorBrush" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />

    <!--  Window Chrome - Close Button  -->
    <SolidColorBrush x:Key="WindowCloseButtonBackgroundPointerOverBrush" Color="{DynamicResource WindowCloseButtonBackgroundPointerOver}" />
    <SolidColorBrush x:Key="WindowCloseButtonBackgroundPressedBrush" Color="{DynamicResource WindowCloseButtonBackgroundPressed}" />
    <SolidColorBrush x:Key="WindowCloseButtonForegroundPointerOverBrush" Color="{DynamicResource WindowCloseButtonForegroundPointerOver}" />
    <SolidColorBrush x:Key="WindowCloseFillColorHoverBrush" Color="{DynamicResource WindowCloseFillColorHover}" />
    <SolidColorBrush x:Key="WindowCloseFillColorPressedBrush" Color="{DynamicResource WindowCloseFillColorPressed}" />
    <SolidColorBrush x:Key="WindowCloseForegroundHoverBrush" Color="{DynamicResource WindowCloseForegroundHover}" />
    <SolidColorBrush x:Key="WindowCloseForegroundPressedBrush" Color="{DynamicResource WindowCloseForegroundPressed}" />

    <!--  Elevation Border Brushes (LinearGradientBrush)  -->
    <LinearGradientBrush x:Key="ControlElevationBorderBrush" x:Shared="False" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform CenterY="0.5" ScaleY="-1" />
        </LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.33" Color="{DynamicResource ControlStrokeColorSecondary}" />
        <GradientStop Offset="1.0" Color="{DynamicResource ControlStrokeColorDefault}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CircleElevationBorderBrush" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.50" Color="{DynamicResource ControlStrokeColorDefault}" />
        <GradientStop Offset="0.70" Color="{DynamicResource ControlStrokeColorSecondary}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentControlElevationBorderBrush" x:Shared="False" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform CenterY="0.5" ScaleY="-1" />
        </LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.33" Color="{DynamicResource ControlStrokeColorOnAccentSecondary}" />
        <GradientStop Offset="1.0" Color="{DynamicResource ControlStrokeColorOnAccentDefault}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TextControlElevationBorderBrush" x:Shared="False" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform CenterY="0.5" ScaleY="-1" />
        </LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.33" Color="{DynamicResource ControlStrokeColorSecondary}" />
        <GradientStop Offset="1.0" Color="{DynamicResource ControlStrokeColorDefault}" />
    </LinearGradientBrush>

    <!--  ═══════════════════════════════════════════════════════════════════════════  -->
    <!--  Step 3.0 - Shared layout / shadow / focus tokens (WI-3 + WI-5A prerequisite)  -->
    <!--  ═══════════════════════════════════════════════════════════════════════════  -->

    <!--  Corner radius tokens - WinUI 3: ControlCornerRadius / OverlayCornerRadius / PopupCornerRadius  -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <!--  PopupCornerRadius: alias for OverlayCornerRadius per .NET 10 WPF Variables.xaml (8,8,8,8).  -->
    <CornerRadius x:Key="PopupCornerRadius">8</CornerRadius>

    <!--  Flyout drop shadow (BlurRadius=18 matches WinUI MicaBackdrop shadow profile)  -->
    <DropShadowEffect
        x:Key="FlyoutShadowEffect"
        BlurRadius="18"
        Direction="270"
        Opacity="0.22"
        ShadowDepth="4"
        Color="Black" />

    <!--
        Shared focus-visual style. Replaces per-control ButtonFocusVisual / CheckBoxFocusVisual
        duplicates for controls whose CornerRadius matches the 4 px canonical value.
        Authority: in-tree Button.xaml / CheckBox.xaml focus-visual pattern (§4.1).
    -->
    <Style x:Key="DefaultControlFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Border
                            Margin="-3"
                            BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}"
                            BorderThickness="2"
                            CornerRadius="4" />
                        <Border
                            Margin="-2"
                            BorderBrush="{DynamicResource FocusStrokeColorInnerBrush}"
                            BorderThickness="1"
                            CornerRadius="4" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Collection-item focus visual: inset single-stroke Rectangle, no margin.
        Used by ListBoxItem, ListViewItem, TreeViewItem - draws inside item bounds.
        Authority: .NET 10 WPF DefaultFocusVisualStyle.xaml (DefaultCollectionFocusVisualStyle).
        Uses FocusStrokeColorOuterBrush consistent with DefaultControlFocusVisualStyle above.
    -->
    <Style x:Key="DefaultCollectionFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle
                        RadiusX="4"
                        RadiusY="4"
                        Stroke="{DynamicResource FocusStrokeColorOuterBrush}"
                        StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
