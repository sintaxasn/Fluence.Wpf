<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Windows 11 Fluent - Accent layer  -->
    <!--  Initial defaults use #0078D4 (Windows blue). The AccentManager overwrites  -->
    <!--  these Color keys at runtime with the system accent ramp, then the brushes  -->
    <!--  pick up changes automatically via DynamicResource.  -->
    <!--  This dictionary is NOT loaded in HighContrast mode.  -->

    <!--  ================================================================  -->
    <!--  Base accent ramp (overwritten at runtime by AccentManager)  -->
    <!--  ================================================================  -->

    <Color x:Key="SystemAccentColor">#FF0078D4</Color>
    <Color x:Key="SystemAccentColorLight1">#FF0091F8</Color>
    <Color x:Key="SystemAccentColorLight2">#FF4CC2FF</Color>
    <Color x:Key="SystemAccentColorLight3">#FF99EBFF</Color>
    <Color x:Key="SystemAccentColorDark1">#FF0067C0</Color>
    <Color x:Key="SystemAccentColorDark2">#FF003E92</Color>
    <Color x:Key="SystemAccentColorDark3">#FF001A68</Color>

    <!--  AccentManager sets these per-theme at runtime. Defaults here are for Light.  -->
    <Color x:Key="SystemAccentColorPrimary">#FF0067C0</Color>
    <Color x:Key="SystemAccentColorSecondary">#FF003E92</Color>
    <Color x:Key="SystemAccentColorTertiary">#FF001A68</Color>

    <!--  Derived from the defaults (in this case, Light) color with alpha steps  -->
    <Color x:Key="AccentFillColorDefault">#FF0067C0</Color>
    <Color x:Key="AccentFillColorSecondary">#E60067C0</Color>
    <Color x:Key="AccentFillColorTertiary">#CC0067C0</Color>

    <!--  AccentFillColorDisabled, TextOnAccent*, and AccentTextFillColorDisabled are theme-dependent.  -->
    <Color x:Key="TextOnAccentFillColorSelectedText">#FFFFFFFF</Color>

    <!--  ================================================================  -->
    <!--  Accent Brushes  -->
    <!--  ================================================================  -->

    <!--  Base ramp brushes  -->
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{DynamicResource SystemAccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="{DynamicResource SystemAccentColorLight1}" />
    <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="{DynamicResource SystemAccentColorLight2}" />
    <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="{DynamicResource SystemAccentColorLight3}" />
    <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="{DynamicResource SystemAccentColorDark1}" />
    <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="{DynamicResource SystemAccentColorDark2}" />
    <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="{DynamicResource SystemAccentColorDark3}" />

    <!--  Theme-adaptive brushes  -->
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{DynamicResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{DynamicResource SystemAccentColorSecondary}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{DynamicResource SystemAccentColorTertiary}" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorBrush" Color="{DynamicResource SystemAccentColor}" />

    <!--  Accent fill brushes  -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{DynamicResource AccentFillColorDefault}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{DynamicResource AccentFillColorSecondary}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{DynamicResource AccentFillColorTertiary}" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="{DynamicResource AccentFillColorDisabled}" />

    <!-- Accent Text Fill Colors -->
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{DynamicResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{DynamicResource SystemAccentColorSecondary}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{DynamicResource AccentFillColorDefault}" />

    <!--  Accent selection highlight  -->
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{DynamicResource SystemAccentColor}" />

    <!--  Text on accent surface brushes (Primary/Secondary/Disabled resolve to the active theme and are also refreshed by code)  -->
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{DynamicResource TextOnAccentFillColorSelectedText}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{DynamicResource TextOnAccentFillColorSecondary}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="{DynamicResource TextOnAccentFillColorDisabled}" />

</ResourceDictionary>
