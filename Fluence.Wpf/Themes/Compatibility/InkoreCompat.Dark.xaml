<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  iNKORE Compatibility Layer — Dark Theme  -->
    <!--  Overrides standard Fluence.Wpf Color keys with higher-opacity values that  -->
    <!--  approximate iNKORE.Modern.UI's visual behavior. Use when migrating an app  -->
    <!--  from iNKORE to Fluence.Wpf to prevent transparency-related regressions.  -->
    <!--  See docs/RESOURCE_AUDIT.md Section 2 for the rationale behind each override.  -->

    <!--  P0 — Control Fill Colors (prevent illegible text on translucent backdrops)  -->
    <Color x:Key="ControlFillColorDefault">#33FFFFFF</Color>
    <Color x:Key="ControlFillColorSecondary">#40FFFFFF</Color>
    <Color x:Key="ControlFillColorTertiary">#26FFFFFF</Color>
    <Color x:Key="ControlFillColorQuarternary">#33FFFFFF</Color>

    <!--  P0 — Card Background Fill Colors  -->
    <Color x:Key="CardBackgroundFillColorDefault">#33FFFFFF</Color>
    <Color x:Key="CardBackgroundFillColorSecondary">#26FFFFFF</Color>

    <!--  P0 — Layer Fill Colors  -->
    <Color x:Key="LayerFillColorDefault">#993A3A3A</Color>
    <Color x:Key="LayerOnMicaBaseAltFillColorDefault">#B33A3A3A</Color>

    <!--  P0 — Acrylic Background (solid fallback matching iNKORE behavior)  -->
    <Color x:Key="AcrylicBackgroundFillColorDefault">#FF2C2C2C</Color>
    <Color x:Key="AcrylicBackgroundFillColorBase">#FF1C1C1C</Color>

    <!--  iNKORE Legacy Brush Aliases (referenced by PSADT via ThemeKeys)  -->
    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="ProgressRingBackgroundThemeBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="{DynamicResource AccentFillColorDefault}" />

    <!--  AccentButtonStyle (referenced by PSADT via ThemeKeys.AccentButtonStyleKey)  -->
    <Style x:Key="AccentButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,5,11,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="AccentBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="AccentBorder" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="AccentBorder" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="AccentBorder" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
                            <Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
