<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Theme-independent tokens.
        
        Only Color resources whose value is identical across Theme.Light.xaml,
        Theme.Dark.xaml, AND Theme.HighContrast.xaml live here. Per-theme
        dictionaries no longer carry these keys.
        
        Audit baseline (from the task #16 split):
        - SurfaceStrokeColorDefault, SmokeFillColorDefault: NOT truly shared -
        HC overrides them (#FF808080 / #FF000000 vs the Light/Dark
        #66757575 / #4D000000). They stay in per-theme files.
        - WindowCloseFillColor* / WindowCloseForeground* family: also NOT
        truly shared - HC overrides hover and pressed to its
        accent / WindowText pair.
        
        Loaded as slot [5] in the canonical merge stack (see
        ApplicationThemeManager). The slot is loaded once, never replaced,
        and never participates in PromoteThemeColors - shared values do not
        change with the theme so promotion is unnecessary.
    -->

    <!--
        Windows close-button danger colors. These are the canonical Windows
        close-button hover / pressed reds and the white foreground on top -
        the Windows shell uses the same values in Light, Dark, and
        HighContrast modes. The red is a Windows-wide brand color, not
        theme-tinted.
    -->
    <Color x:Key="WindowCloseButtonBackgroundPointerOver">#FFC42B1C</Color>
    <Color x:Key="WindowCloseButtonBackgroundPressed">#FFB4271C</Color>
    <Color x:Key="WindowCloseButtonForegroundPointerOver">#FFFFFFFF</Color>

</ResourceDictionary>
