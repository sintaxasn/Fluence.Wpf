<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:flu="clr-namespace:Fluence.Wpf;assembly=Fluence.Wpf">
    <flu:AcrylicMaterialRecipe x:Key="FixedRecipe" TintColor="#CCFFFFFF"
                               TintOpacity="1" FallbackColor="#FFF9F9F9" />
    <Grid x:Key="DirectUses" x:Shared="False" Width="240" Height="180">
        <Border x:Name="BackdropRoot" Background="DarkSlateBlue" />
        <Border x:Name="DirectBorder" Width="72" Height="50" HorizontalAlignment="Left"
                VerticalAlignment="Top" Margin="10,10,0,0"
                Background="{flu:AcrylicBrush BackdropSourceName=BackdropRoot, Recipe={StaticResource FixedRecipe}}" />
        <Rectangle x:Name="DirectRectangle" Width="72" Height="50" HorizontalAlignment="Right"
                   VerticalAlignment="Top" Margin="0,10,10,0"
                   Fill="{flu:AcrylicBrush BackdropSourceName=BackdropRoot}" />
        <Ellipse x:Name="DirectEllipse" Width="72" Height="50" HorizontalAlignment="Left"
                 VerticalAlignment="Bottom" Margin="10,0,0,10"
                 Fill="{flu:AcrylicBrush BackdropSourceName=BackdropRoot}" />
        <Border x:Name="MissingSourceBorder" Width="72" Height="50" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Margin="0,0,10,10"
                Background="{flu:AcrylicBrush BackdropSourceName=NotRegistered}" />
    </Grid>
</ResourceDictionary>
