<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFrameworks>net472;net10.0-windows10.0.26100.0</TargetFrameworks>
    <LangVersion Condition="'$(TargetFramework)' == 'net472'">7.3</LangVersion>
    <LangVersion Condition="$(TargetFramework.StartsWith('net10'))">latest</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Fluence.Wpf.Tests</RootNamespace>
    <AssemblyName>Fluence.Wpf.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TestTfmsInParallel>false</TestTfmsInParallel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.2.2" />
    <PackageReference Include="MSTest.TestFramework" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluence.Wpf\Fluence.Wpf.csproj" />
    <ProjectReference Include="..\Fluence.Wpf.Demo\Fluence.Wpf.Demo.csproj" />
  </ItemGroup>

</Project>
